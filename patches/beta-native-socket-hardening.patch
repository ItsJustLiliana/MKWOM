+static void ov_close(Cpu *c) {
+    int fd = (int)arg_x(c, 0);
+    uint64_t tx = 0, rx = 0, last_rx = 0, last_tx = 0;
+    uint32_t gaps_rx = 0, gaps_tx = 0, errors = 0;
+    int was_udp = 0;
+    plat_mutex_lock(&fd_lock);
+    GFd *f = fd_get(fd, 0);
+    HostSock s = f ? f->s : HOST_BAD, w = f ? f->w : HOST_BAD;
+    // Snapshot diagnostics before making the descriptor reusable by another
+    // game thread; otherwise a fresh socket's counters can be read on close.
+    if (f) {
+        was_udp = f->type == 2 && udp_trace();
+        if (was_udp) {
+            tx = __atomic_load_n(&f->udp_tx_packets, __ATOMIC_RELAXED);
+            rx = __atomic_load_n(&f->udp_rx_packets, __ATOMIC_RELAXED);
+            last_rx = __atomic_load_n(&f->udp_rx_last_ns, __ATOMIC_RELAXED);
+            last_tx = __atomic_load_n(&f->udp_tx_last_ns, __ATOMIC_RELAXED);
+            gaps_rx = __atomic_load_n(&f->udp_rx_gaps, __ATOMIC_RELAXED);
+            gaps_tx = __atomic_load_n(&f->udp_tx_gaps, __ATOMIC_RELAXED);
+            errors = __atomic_load_n(&f->udp_errors, __ATOMIC_RELAXED);
+        }
+        f->kind = FD_FREE;
+    }
+    plat_mutex_unlock(&fd_lock);
+    if (!f) return ret_fail(c, G_EBADF);
+    if (was_udp) {
+        uint64_t now = plat_now_ns();
+        rt_log("net-udp: fd=%d closed tx=%llu rx=%llu rx_idle_ms=%llu tx_idle_ms=%llu gaps_rx=%u gaps_tx=%u errors=%u",
+               fd, (unsigned long long)tx, (unsigned long long)rx,
+               (unsigned long long)(last_rx && now >= last_rx ? (now - last_rx) / 1000000ull : 0),
+               (unsigned long long)(last_tx && now >= last_tx ? (now - last_tx) / 1000000ull : 0),
+               gaps_rx, gaps_tx, errors);
+    }
+    if (s != HOST_BAD) host_close(s);
+    if (w != HOST_BAD) host_close(w);
+    ret_x(c, 0);
+}
 
