+static int set_udp_ports(const char *text) {
+    int values[5];
+    for (int i = 0; i < 5; i++) {
+        if (*text < '0' || *text > '9') return 0;
+        char *end = NULL;
+        long value = strtol(text, &end, 10);
+        if (value < 1024 || value > 65535 ||
+            (i < 4 ? *end != ',' : *end != '\0')) return 0;
+        for (int j = 0; j < i; j++) if (values[j] == value) return 0;
+        values[i] = (int)value;
+        text = i < 4 ? end + 1 : end;
+    }
+    for (int i = 0; i < 5; i++) UDP_PORTS[i].port = values[i];
+    return 1;
+}
