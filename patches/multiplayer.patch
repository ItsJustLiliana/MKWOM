+int net_identity_token(const char *build, char *out, size_t cap) {
+    const NetServer *s = net_server();
+    NetProfile p;
+    if (!s->on || !net_profile_load(s->text, &p, 1)) return 0;
+    char friends[NET_MAX_CODES * 13 + 1], removed[NET_MAX_CODES * 13 + 1];
+    join_codes(friends, sizeof friends, (const char (*)[13])p.friends, p.nfriends);
+    join_codes(removed, sizeof removed, (const char (*)[13])p.removed, p.nremoved);
+    char game_ticket[256];
+    if (!mkwom_game_ticket(p.code, game_ticket, sizeof game_ticket)) {
+        rt_log("mkwom: account session missing, revoked or unreachable; refusing online sign-in");
+        return 0;
+    }
+    int n = snprintf(out, cap, "droplet-online-v1;code=%s;secret=%s%s%s;friends=%s%s%s;mkwom=%s",
+                     p.code, p.secret, build && *build ? ";build=" : "", build ? build : "",
+                     friends, p.nremoved ? ";removed=" : "", removed, game_ticket);
+    memset(game_ticket, 0, sizeof game_ticket);
+    return n > 0 && (size_t)n < cap;
+}
