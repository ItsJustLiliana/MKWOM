-// CalendarTime ToCalendarTimeInUtc(const PosixTime &t): 8 bytes in x0
-static void ov_to_calendar_utc(Cpu *c) {
-    const int64_t *t = arg_p(c, 0);
-    CalendarTime ct;
-    utc_calendar(t ? *t : 0, &ct, NULL);
-    uint64_t v;
-    memcpy(&v, &ct, 8);
