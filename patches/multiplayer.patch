+// A regular double-click on patched mkw.exe delegates updates to the
+// separately installed, silent MKWOM helper before loading any game files.
+// The managed child gets MKWOM_MANAGED=1; a direct launch never needs a shell.
+int net_mkwom_start_updater(void) {
+#ifdef _WIN32
+    wchar_t exe[MAX_PATH];
+    DWORD len = GetModuleFileNameW(NULL, exe, MAX_PATH);
+    if (!len || len >= MAX_PATH) return -1;
+    wchar_t *slash = wcsrchr(exe, L'\\');
+    if (!slash) return -1;
+    *slash = 0;
+    wchar_t helper[2 * MAX_PATH];
+    if (swprintf(helper, sizeof helper / sizeof *helper,
+                 L"%ls\\.mkwom\\updater.exe", exe) <= 0) return -1;
+    if (GetFileAttributesW(helper) == INVALID_FILE_ATTRIBUTES) {
+        MessageBoxW(NULL, L"MKWOM setup is incomplete. Install multiplayer with mkwom.exe first.",
+                    L"MKWOM", MB_OK | MB_ICONERROR);
+        return -1;
+    }
+    wchar_t cmd[4 * MAX_PATH];
+    if (swprintf(cmd, sizeof cmd / sizeof *cmd,
+                 L"\"%ls\" --autostart --game \"%ls\" --parent-pid %lu",
+                 helper, exe, (unsigned long)GetCurrentProcessId()) <= 0) return -1;
+    STARTUPINFOW start = {0};
+    PROCESS_INFORMATION proc = {0};
+    start.cb = sizeof start;
+    if (!CreateProcessW(helper, cmd, NULL, NULL, FALSE, 0, NULL, exe, &start, &proc)) {
+        MessageBoxW(NULL, L"Could not start the MKWOM updater from this game folder.",
+                    L"MKWOM", MB_OK | MB_ICONERROR);
+        return -1;
+    }
+    CloseHandle(proc.hThread);
+    CloseHandle(proc.hProcess);
+    return 1;
+#else
+    return 0;
+#endif
+}
