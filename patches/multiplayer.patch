-    const char *args[] = {"add", "--name", "Mario Kart World", "--exe", exe, "--dir", L.exe_dir,
-                          drawn == 5 ? "--art" : nullptr, dir, nullptr};
-    tool_start(L.exe_dir, JOB_STEAM, "prepare/steam.py", args);
