+    assert os.environ["ZIG_GLOBAL_CACHE_DIR"] == own and os.environ["ZIG_LOCAL_CACHE_DIR"] == own
+
+
+def test_zig_cache_the_players_own(monkeypatch, tmp_path: Path) -> None:
