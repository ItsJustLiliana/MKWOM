-__attribute__((constructor)) static void tick_scale_init(void) { tick_scale = plat_scale(RT_TICK_HZ, plat_counter_hz()); }
-
-uint64_t rt_ticks_real(void) { return plat_scaled(tick_scale, plat_counter()); }
