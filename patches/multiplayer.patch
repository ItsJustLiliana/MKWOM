+sys.path.insert(0, str(ROOT / "sm86/spec"))
+sys.path.insert(0, str(ROOT / "tools/prepare"))
+import prepare  # noqa: E402
+import gamesource  # noqa: E402  (after prepare: it puts recomp/ on the path)
