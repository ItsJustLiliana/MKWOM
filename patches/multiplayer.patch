+msgstr ""
+
+msgctxt "UI_F1_FAILED"
+msgid "Local server failed"
+msgstr ""
+
+msgctxt "UI_F1_INVITE"
+msgid "Server invite code (share with trusted friends)"
+msgstr ""
+
+msgctxt "UI_F1_JOIN"
+msgid "Join a server by invite code"
+msgstr ""
+
+msgctxt "UI_F1_CONNECT"
+msgid "Connect and save server"
+msgstr ""
+
+msgctxt "UI_F1_INVALID_INVITE"
+msgid "Invalid server invite. Paste the full MKW1 code, including its dashes."
+msgstr ""
