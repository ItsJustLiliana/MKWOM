diff --git a/runtime/sdk/ov/net_host.c b/runtime/sdk/ov/net_host.c
new file mode 100644
index 0000000..9ef7855
--- /dev/null
+++ b/runtime/sdk/ov/net_host.c
@@ -0,0 +1,558 @@
+// Integrated from Gael50/mkw-recomp @ 918bbd6523729cd18636c051a1e6e62101fd155f (MIT), PR #354.
+// This PC's networks and its own online server, started by mkw (net_online.h).
+//
+// The server is built into the executable (runtime/srv): `mkw --server`, with its data (keys, accounts, logs) in
+// server/ next to mkw. MKW_SERVER_HOST=1 starts it with the start screen, or with the game when it starts without one.
+// It runs in a job object of the process that started it, which kills it when that process ends: the start screen's
+// process waits for the game it starts (plat_reexec), so the server stops when the game, or the start screen, closes.
+//
+// MKW_NETWORK picks the networks: auto (Tailscale and the home network), home (the box's network: the adapter with a
+// gateway) or tailscale (100.64.0.0/10). The server listens on 127.0.0.1 and the chosen ones, never on a public
+// address; this PC plays it at the chosen network's address (auto: Tailscale's when it is up), the one its friends
+// write, so the address the game reports to the others is one they reach.
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <iphlpapi.h>
+#include <windows.h>
+#include <shellapi.h>
+#else
+#include <arpa/inet.h>
+#include <fcntl.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <wchar.h>
+
+#include "cfg.h"
+#include "menu.h"
+#include "net_listen.h"
+#include "net_online.h"
+#include "ov.h"
+#include "platform/platform.h"
+#include "ui_text.h"
+
+void rt_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+static void sock_init(void) {
+#ifdef _WIN32
+    static volatile int done;
+    if (!done) {
+        WSADATA w;
+        WSAStartup(MAKEWORD(2, 2), &w);
+        done = 1;
+    }
+#endif
+}
+
+static int is_private(uint32_t h) { return (h >> 24) == 10 || (h >> 20) == 0xac1 || (h >> 16) == 0xc0a8; }
+static int is_tailscale(uint32_t h) { return (h >> 22) == (100u << 2 | 1); }
+static void fmt_ip(char out[16], uint32_t h) {
+    snprintf(out, 16, "%u.%u.%u.%u", h >> 24, (h >> 16) & 255, (h >> 8) & 255, h & 255);
+}
+
+// Every IPv4 address of an adapter that is up (host order), with whether its adapter has a gateway and its metric.
+typedef void (*AddrFn)(uint32_t h, int gateway, unsigned metric, int prefix, void *ctx);
+static void each_address(AddrFn fn, void *ctx) {
+#ifdef _WIN32
+    ULONG flags = GAA_FLAG_INCLUDE_GATEWAYS | GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER;
+    ULONG size = 32 << 10, r = ERROR_BUFFER_OVERFLOW;
+    IP_ADAPTER_ADDRESSES *list = NULL;
+    for (int tries = 0; tries < 3 && r == ERROR_BUFFER_OVERFLOW; tries++) {
+        free(list);
+        list = malloc(size);
+        r = list ? GetAdaptersAddresses(AF_INET, flags, NULL, list, &size) : ERROR_NOT_ENOUGH_MEMORY;
+    }
+    for (IP_ADAPTER_ADDRESSES *i = r == NO_ERROR ? list : NULL; i; i = i->Next) {
+        if (i->OperStatus != IfOperStatusUp || i->IfType == IF_TYPE_SOFTWARE_LOOPBACK) continue;
+        for (IP_ADAPTER_UNICAST_ADDRESS *u = i->FirstUnicastAddress; u; u = u->Next)
+            fn(ntohl(((struct sockaddr_in *)u->Address.lpSockaddr)->sin_addr.s_addr), i->FirstGatewayAddress != NULL,
+               (unsigned)i->Ipv4Metric, u->OnLinkPrefixLength, ctx);
+    }
+    free(list);
+#else
+    struct ifaddrs *list, *i;
+    if (getifaddrs(&list)) return;
+    for (i = list; i; i = i->ifa_next) {
+        if (!i->ifa_addr || !i->ifa_netmask || i->ifa_addr->sa_family != AF_INET || !(i->ifa_flags & IFF_UP) ||
+            (i->ifa_flags & IFF_LOOPBACK))
+            continue;
+        uint32_t m = ntohl(((struct sockaddr_in *)i->ifa_netmask)->sin_addr.s_addr);
+        fn(ntohl(((struct sockaddr_in *)i->ifa_addr)->sin_addr.s_addr), m != 0xffffffffu, 0,
+           m == 0xffffffffu ? 32 : 24, ctx);   // no gateway list here: a real subnet stands for one
+    }
+    freeifaddrs(list);
+#endif
+}
+
+typedef struct { NetAddrs *a; unsigned best; } PickCtx;
+static void pick(uint32_t h, int gateway, unsigned metric, int prefix, void *ctx) {
+    PickCtx *p = ctx;
+    if (is_tailscale(h)) {
+        if (!p->a->ts[0]) fmt_ip(p->a->ts, h);
+    } else if (gateway && prefix < 32 && is_private(h) && metric < p->best) {   // the box's network: the default route
+        p->best = metric;
+        fmt_ip(p->a->home, h);
+    }
+}
+
+void net_addrs(NetAddrs *a) {
+    memset(a, 0, sizeof *a);
+    PickCtx p = {a, ~0u};
+    each_address(pick, &p);
+}
+
+const char *net_network(void) {
+    const char *v = cfg_get("MKW_NETWORK");
+    return v && (!strcmp(v, "home") || !strcmp(v, "tailscale")) ? v : "auto";
+}
+
+// The chosen network's address of this PC; auto: Tailscale's when it is up, else the home network's. "" when none.
+const char *net_network_address(const NetAddrs *a) {
+    const char *n = net_network();
+    if (!strcmp(n, "home")) return a->home;
+    if (!strcmp(n, "tailscale")) return a->ts;
+    return a->ts[0] ? a->ts : a->home;
+}
+
+typedef struct { uint32_t want; int found; } LocalCtx;
+static void match(uint32_t h, int gateway, unsigned metric, int prefix, void *ctx) {
+    (void)gateway, (void)metric, (void)prefix;
+    LocalCtx *l = ctx;
+    if (h == l->want) l->found = 1;
+}
+
+int net_is_this_pc(uint32_t ip) {
+    uint32_t h = ntohl(ip);
+    if ((h >> 24) == 127) return 1;
+    LocalCtx l = {h, 0};
+    each_address(match, &l);
+    return l.found;
+}
+
+// ---- this PC: a hash of the system's own machine id (Windows' MachineGuid, Linux's /etc/machine-id), never the id
+// itself. A friend code or a server's keys made on another PC (a copied folder) are told apart with it.
+static uint64_t fnv1a(uint64_t h, const char *s) {
+    for (; *s; s++) h = (h ^ (uint8_t)*s) * 0x100000001b3ull;
+    return h;
+}
+
+static char machine_id[17];
+
+const char *net_machine_id(void) {
+    if (machine_id[0]) return machine_id;
+    char raw[128] = "";
+#ifdef _WIN32
+    wchar_t w[64];
+    DWORD size = sizeof w;
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, L"SOFTWARE\\Microsoft\\Cryptography", L"MachineGuid",
+                     RRF_RT_REG_SZ, NULL, w, &size) == ERROR_SUCCESS)
+        WideCharToMultiByte(CP_UTF8, 0, w, -1, raw, sizeof raw, NULL, NULL);
+#else
+    uint64_t size = 0;
+    char *t = (char *)plat_file_read("/etc/machine-id", &size);
+    if (t) snprintf(raw, sizeof raw, "%.*s", (int)(size < 127 ? size : 127), t), free(t);
+#endif
+    // FNV-1a, salted: the id cannot be read back from it
+    snprintf(machine_id, sizeof machine_id, "%016llx",
+             (unsigned long long)fnv1a(fnv1a(0xcbf29ce484222325ull, "mkw-recomp/machine-id/"), raw));
+    if (!raw[0]) rt_log("net: no machine id: copied folders cannot be told apart");
+    return machine_id;
+}
+
+// ---- the server: built in, its data in server/ next to mkw
+int net_host_enabled(void) { return cfg_bool("MKW_SERVER_HOST"); }
+
+int net_host_available(void) {
+#ifdef _WIN32
+    return 1;   // built in
+#else
+    return 0;   // starting it from the start screen is in the Windows build for now (mkw --server runs anywhere)
+#endif
+}
+
+// 127.0.0.1:8443 accepts a connection (150 ms at most): a server runs on this PC
+static int port_answers(void) {
+    sock_init();
+    struct sockaddr_in to = {.sin_family = AF_INET, .sin_port = htons(NET_HOST_PORT)};
+    to.sin_addr.s_addr = htonl(0x7f000001);
+    int ok = 0;
+#ifdef _WIN32
+    SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+    if (s == INVALID_SOCKET) return 0;
+    u_long nb = 1;
+    ioctlsocket(s, FIONBIO, &nb);
+    connect(s, (struct sockaddr *)&to, sizeof to);
+    fd_set w, e;
+    FD_ZERO(&w);
+    FD_ZERO(&e);
+    FD_SET(s, &w);
+    FD_SET(s, &e);
+    struct timeval tv = {0, 150000};
+    int error = 0, error_len = sizeof error;
+    if (select(0, NULL, &w, &e, &tv) > 0 && FD_ISSET(s, &w) &&
+        !getsockopt(s, SOL_SOCKET, SO_ERROR, (char *)&error, &error_len) && !error) ok = 1;
+    closesocket(s);
+#else
+    int s = socket(AF_INET, SOCK_STREAM, 0);
+    if (s < 0) return 0;
+    fcntl(s, F_SETFL, fcntl(s, F_GETFL) | O_NONBLOCK);
+    connect(s, (struct sockaddr *)&to, sizeof to);
+    struct pollfd p = {s, POLLOUT, 0};
+    int err = 0;
+    socklen_t el = sizeof err;
+    if (poll(&p, 1, 150) == 1 && !getsockopt(s, SOL_SOCKET, SO_ERROR, &err, &el) && !err) ok = 1;
+    close(s);
+#endif
+    return ok;
+}
+
+#ifdef _WIN32
+// The server's folder (server/ next to mkw) and other files beside the executable
+static int beside_exe(const char *name, char *out, size_t cap) {
+    char exe[1024];
+    int n = plat_exe_path(exe, sizeof exe);
+    char *cut = n > 0 && n < (int)sizeof exe ? plat_last_sep(exe) : NULL;
+    if (!cut) return 0;
+    *cut = 0;
+    snprintf(out, cap, "%s/%s", exe, name);
+    return 1;
+}
+
+static HANDLE server_stop_event(DWORD pid) {
+    if (!pid) {
+        char path[1200];
+        if (beside_exe("server/pid", path, sizeof path)) {
+            uint64_t size;
+            char *text = (char *)plat_file_read(path, &size);
+            if (text && size < 16) {
+                char number[16] = {0};
+                memcpy(number, text, (size_t)size);
+                pid = (DWORD)strtoul(number, NULL, 10);
+            }
+            free(text);
+        }
+    }
+    wchar_t name[80];
+    swprintf(name, sizeof name / sizeof *name, L"Local\\MKWRecompServerStop-%lu", pid);
+    return pid ? OpenEventW(EVENT_MODIFY_STATE, FALSE, name) : NULL;
+}
+
+// The addresses the server listens on for the network choice: 127.0.0.1, then the chosen networks' that are up
+static void listen_list(char *out, size_t cap) {
+    NetAddrs a;
+    net_addrs(&a);
+    const char *n = net_network();
+    snprintf(out, cap, "127.0.0.1");
+    if (a.home[0] && strcmp(n, "tailscale")) snprintf(out + strlen(out), cap - strlen(out), ",%s", a.home);
+    if (a.ts[0] && strcmp(n, "home")) snprintf(out + strlen(out), cap - strlen(out), ",%s", a.ts);
+}
+
+static PlatMutex host_lock = PLAT_MUTEX_INIT;
+static HANDLE host_job, host_proc;
+static char host_listen[128];
+static char host_error[200];
+
+static wchar_t *wide(const char *s) {
+    int n = MultiByteToWideChar(CP_UTF8, 0, s, -1, NULL, 0);
+    wchar_t *w = n > 0 ? malloc((size_t)n * sizeof *w) : NULL;
+    if (w) MultiByteToWideChar(CP_UTF8, 0, s, -1, w, n);
+    return w;
+}
+
+static HANDLE open_inheritable(const char *path, int write) {
+    wchar_t *w = wide(path);
+    SECURITY_ATTRIBUTES sa = {sizeof sa, NULL, TRUE};
+    HANDLE h = w ? CreateFileW(w, write ? GENERIC_WRITE : GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa,
+                               write ? CREATE_ALWAYS : OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL)
+                 : INVALID_HANDLE_VALUE;
+    free(w);
+    return h;
+}
+
+static char host_console[1300];   // the running server's error output (why it stopped)
+
+// The last line of the server's error output: why it stopped
+static void last_error_line(const char *path, char *out, size_t cap) {
+    uint64_t size = 0;
+    char *t = (char *)plat_file_read(path, &size);
+    out[0] = 0;
+    if (!t) return;
+    while (size && (t[size - 1] == '\n' || t[size - 1] == '\r' || t[size - 1] == ' ')) size--;
+    size_t start = size;
+    while (start && t[start - 1] != '\n') start--;
+    snprintf(out, cap, "%.*s", (int)(size - start), t + start);
+    free(t);
+}
+
+static void host_close_handles(void) {
+    if (host_proc) CloseHandle(host_proc);
+    if (host_job) CloseHandle(host_job);   // KILL_ON_JOB_CLOSE: ends the server if it still runs
+    host_proc = host_job = NULL;
+}
+
+// The server's command line and folder (mkw --server, server/ next to mkw). 0 with err set when it cannot run here.
+static int server_command(const char *hosts, char *cmd, size_t ccap, char *exe, size_t ecap, char *dir, size_t dcap,
+                          char *logs, size_t lcap, char *err, size_t cap) {
+    if (plat_exe_path(exe, ecap) <= 0 || !beside_exe("server", dir, dcap)) {
+        snprintf(err, cap, "this program's own path is unknown");
+        return 0;
+    }
+    snprintf(logs, lcap, "%s/logs", dir);
+    int n = snprintf(cmd, ccap, "\"%s\" --server --port %d --data \"%s\"", exe, NET_HOST_PORT, dir);
+    for (const char *h = hosts; *h && n > 0 && (size_t)n < ccap;) {   // "a,b,c": --host a --host b --host c
+        size_t len = strcspn(h, ",");
+        n += snprintf(cmd + n, ccap - (size_t)n, " --host %.*s", (int)len, h);
+        h += len + (h[len] == ',');
+    }
+    return n > 0 && (size_t)n < ccap;
+}
+
+int net_host_start(char *err, size_t cap) {
+    char dir[1100], exe[1100], logs[1200], out_path[1300], hosts[128], cmd[4096];
+    err[0] = 0;
+    if (!beside_exe("server", dir, sizeof dir)) {
+        snprintf(err, cap, "this program's own path is unknown");
+        return -1;
+    }
+    // The server's keys and accounts belong to the PC that made them: a folder copied from another PC is set aside,
+    // never used (its private key is that PC's identity), and this PC's server makes its own keys at its first start.
+    char data[1150], mark[1200];
+    snprintf(data, sizeof data, "%s", dir);
+    snprintf(mark, sizeof mark, "%s/machine-id", data);
+    uint64_t msize = 0;
+    char *m = (char *)plat_file_read(mark, &msize);
+    int marked = m != NULL, foreign = marked && (msize < 16 || memcmp(m, net_machine_id(), 16));
+    free(m);
+    if (foreign) {
+        char aside[1250];
+        snprintf(aside, sizeof aside, "%s.autre-pc-%llu", data, (unsigned long long)time(NULL));
+        if (!plat_file_replace(data, aside)) {
+            snprintf(err, cap, "%s was made on another PC and could not be set aside", data);
+            return -1;
+        }
+        rt_log("net: %s was made on another PC: set aside as %s, this PC's server starts anew", data, aside);
+    }
+    if (!marked || foreign) {
+        plat_file_mkdir_p(data);
+        plat_file_write(mark, net_machine_id(), 16);
+    }
+    plat_mutex_lock(&host_lock);
+    if (host_proc && WaitForSingleObject(host_proc, 0) == WAIT_TIMEOUT) {   // ours runs already
+        plat_mutex_unlock(&host_lock);
+        return 0;
+    }
+    host_close_handles();
+    if (port_answers()) {
+        plat_mutex_unlock(&host_lock);
+        snprintf(err, cap, "another server already answers on port %d of this PC", NET_HOST_PORT);
+        return -1;
+    }
+    listen_list(hosts, sizeof hosts);
+    if (!server_command(hosts, cmd, sizeof cmd, exe, sizeof exe, dir, sizeof dir, logs, sizeof logs, err, cap)) {
+        plat_mutex_unlock(&host_lock);
+        if (!err[0]) snprintf(err, cap, "the server's command line is too long");
+        return -1;
+    }
+    plat_file_mkdir_p(logs);
+    snprintf(out_path, sizeof out_path, "%s/console-sortie.txt", logs);
+    snprintf(host_console, sizeof host_console, "%s/console-erreurs.txt", logs);
+    HANDLE in = open_inheritable("NUL", 0), so = open_inheritable(out_path, 1), se = open_inheritable(host_console, 1);
+    HANDLE job = CreateJobObjectW(NULL, NULL);
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION li = {0};
+    li.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    if (job) SetInformationJobObject(job, JobObjectExtendedLimitInformation, &li, sizeof li);
+    // Only the three standard handles are inherited, none of mkw's own files
+    HANDLE inherit[3] = {in, so, se};
+    SIZE_T asize = 0;
+    InitializeProcThreadAttributeList(NULL, 1, 0, &asize);
+    LPPROC_THREAD_ATTRIBUTE_LIST attrs = malloc(asize);
+    int ok = attrs && InitializeProcThreadAttributeList(attrs, 1, 0, &asize) &&
+             UpdateProcThreadAttribute(attrs, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST, inherit, sizeof inherit, NULL, NULL);
+    STARTUPINFOEXW si = {0};
+    si.StartupInfo.cb = sizeof si;
+    si.StartupInfo.dwFlags = STARTF_USESTDHANDLES;
+    si.StartupInfo.hStdInput = in, si.StartupInfo.hStdOutput = so, si.StartupInfo.hStdError = se;
+    si.lpAttributeList = attrs;
+    PROCESS_INFORMATION pi = {0};
+    wchar_t *wcmd = wide(cmd), *wdir = wide(dir), *wexe = wide(exe);
+    ok = ok && in != INVALID_HANDLE_VALUE && so != INVALID_HANDLE_VALUE && se != INVALID_HANDLE_VALUE && wcmd &&
+         wdir && wexe &&
+         CreateProcessW(wexe, wcmd, NULL, NULL, TRUE,
+                        CREATE_NO_WINDOW | CREATE_SUSPENDED | EXTENDED_STARTUPINFO_PRESENT, NULL, wdir,
+                        &si.StartupInfo, &pi);
+    DWORD why = ok ? 0 : GetLastError();
+    const char *name = "online server";
+    if (ok) {
+        if (!job || !AssignProcessToJobObject(job, pi.hProcess))
+            rt_log("net: %s not tied to mkw's lifetime (job error %lu): it outlives mkw", name, GetLastError());
+        ResumeThread(pi.hThread);
+        CloseHandle(pi.hThread);
+        host_proc = pi.hProcess, host_job = job;
+        snprintf(host_listen, sizeof host_listen, "%s", hosts);
+        host_error[0] = 0;
+        plat_setenv("MKW_HOST_STARTED", "1");   // the game this start screen runs finds it started
+        rt_log("net: online server started on %s port %d (pid %lu), stops with mkw", hosts, NET_HOST_PORT,
+               pi.dwProcessId);
+    } else {
+        if (job) CloseHandle(job);
+        snprintf(err, cap, "Windows did not start the %s (error %lu)", name, why);
+        rt_log("net: %s", err);
+    }
+    free(wcmd), free(wdir), free(wexe);
+    if (attrs) DeleteProcThreadAttributeList(attrs), free(attrs);
+    for (int i = 0; i < 3; i++)
+        if (inherit[i] != INVALID_HANDLE_VALUE) CloseHandle(inherit[i]);
+    plat_mutex_unlock(&host_lock);
+    return ok ? 0 : -1;
+}
+
+void net_host_stop(void) {
+    plat_mutex_lock(&host_lock);
+    DWORD pid = host_proc ? GetProcessId(host_proc) : 0;
+    // The launcher may own this process while the game displays F1. Signal only its server event;
+    // never terminate a PID read from disk (it may have been reused by an unrelated program).
+    HANDLE event = server_stop_event(pid);
+    if (event) SetEvent(event), CloseHandle(event);
+    if (host_proc && WaitForSingleObject(host_proc, 5000) != WAIT_OBJECT_0) {
+        rt_log("net: server did not stop in 5 seconds; terminating it");
+        if (host_job) TerminateJobObject(host_job, 0);
+        else TerminateProcess(host_proc, 0);
+    }
+    if (host_proc) {
+        WaitForSingleObject(host_proc, 3000);
+        rt_log("net: the server stopped");
+    }
+    host_close_handles();
+    host_listen[0] = 0;
+    plat_mutex_unlock(&host_lock);
+}
+
+NetHostState net_host_state(char *detail, size_t cap) {
+    if (detail && cap) detail[0] = 0;
+    plat_mutex_lock(&host_lock);
+    NetHostState st;
+    if (host_proc && WaitForSingleObject(host_proc, 0) == WAIT_OBJECT_0) {   // ours ended
+        DWORD code = 0;
+        GetExitCodeProcess(host_proc, &code);
+        last_error_line(host_console, host_error, sizeof host_error);
+        if (!host_error[0]) snprintf(host_error, sizeof host_error, "the server stopped (code %lu)", code);
+        rt_log("net: the server ended: %s", host_error);
+        host_close_handles();
+    }
+    if (host_proc) {
+        st = port_answers() ? NET_HOST_RUNNING : NET_HOST_STARTING;
+        if (detail && cap) snprintf(detail, cap, "%s", host_listen);
+    } else if (port_answers()) {
+        HANDLE event = server_stop_event(0);
+        st = event ? NET_HOST_RUNNING : NET_HOST_OTHER;
+        if (event) {
+            CloseHandle(event);
+            if (detail && cap) listen_list(detail, cap);
+        }
+    } else if (host_error[0]) {
+        st = NET_HOST_FAILED;
+        if (detail && cap) snprintf(detail, cap, "%s", host_error);
+    } else {
+        st = NET_HOST_OFF;
+    }
+    plat_mutex_unlock(&host_lock);
+    return st;
+}
+
+int net_host_listen_changed(void) {
+    static NetListenWatch watch;   // the start screen's thread only
+    char now[128], running[128];
+    listen_list(now, sizeof now);
+    plat_mutex_lock(&host_lock);
+    int on = host_proc != NULL;
+    snprintf(running, sizeof running, "%s", host_listen);
+    plat_mutex_unlock(&host_lock);
+    return on && net_listen_settled(&watch, running, now, plat_now_ms());
+}
+
+// Windows' firewall, once per PC (Windows asks first, "runas"): the built-in server's program may take connections
+// from the local network and from Tailscale (100.64.0.0/10), never from the Internet.
+int net_host_firewall(void) {
+    char exe[1024], args[2600], quoted[2100];
+    int n = plat_exe_path(exe, sizeof exe);
+    if (n <= 0 || n >= (int)sizeof exe) return -1;
+    size_t q = 0;   // the path in a PowerShell single-quoted string: ' doubled
+    for (const char *s = exe; *s && q + 2 < sizeof quoted; s++) {
+        if (*s == '\'') quoted[q++] = '\'';
+        quoted[q++] = *s;
+    }
+    quoted[q] = 0;
+    snprintf(args, sizeof args,
+             "-NoProfile -Command \"Remove-NetFirewallRule -DisplayName 'MKW Recomp server' -ErrorAction "
+             "SilentlyContinue; New-NetFirewallRule -DisplayName 'MKW Recomp server' -Direction Inbound -Action "
+             "Allow -Program '%s' -RemoteAddress LocalSubnet,100.64.0.0/10 -Profile Any | Out-Null\"",
+             quoted);
+    wchar_t *w = wide(args);
+    // "runas": Windows asks the player (UAC) before the firewall changes
+    HINSTANCE r = w ? ShellExecuteW(NULL, L"runas", L"powershell.exe", w, NULL, SW_HIDE) : NULL;
+    free(w);
+    return (INT_PTR)r > 32 ? 0 : -1;
+}
+
+#else
+int net_host_start(char *err, size_t cap) {
+    snprintf(err, cap, "hosting the server is in the Windows build only");
+    return -1;
+}
+void net_host_stop(void) {}
+NetHostState net_host_state(char *detail, size_t cap) {
+    if (detail && cap) detail[0] = 0;
+    return port_answers() ? NET_HOST_OTHER : NET_HOST_OFF;
+}
+int net_host_listen_changed(void) { return 0; }
+int net_host_firewall(void) { return -1; }
+#endif
+
+// A network error the console shows in a dialog the player closes (nifm's network applet, the error applet): the
+// runtime shows no applet, so the game's own line flashes for a second as it goes back to its menu. A notice at the
+// top of the picture says it for 10 seconds instead, with what to check. category 0: no network for the request.
+void net_error_notice(unsigned category, unsigned number) {
+    static PlatMutex lock = PLAT_MUTEX_INIT;
+    static uint64_t last_ms;
+    static unsigned last_key = ~0u;
+    unsigned key = category << 16 ^ number;
+    uint64_t now = plat_now_ms();
+    plat_mutex_lock(&lock);
+    int again = key == last_key && now - last_ms < 5000;   // the same error retried at once: said once
+    last_key = key, last_ms = now;
+    plat_mutex_unlock(&lock);
+    if (again) return;
+    char why[200], text[256];
+    const NetServer *s = net_server();
+    if (!net_enabled()) snprintf(why, sizeof why, "%s", menu_text(UI_NOTICE_OFFLINE));
+    else if (!s->on) snprintf(why, sizeof why, "%s", menu_text(UI_NOTICE_NO_SERVER));
+    else snprintf(why, sizeof why, menu_text(UI_NOTICE_SERVER), s->text);
+    if (category) {
+        char code[16];
+        snprintf(code, sizeof code, "%04u-%04u", category, number);
+        snprintf(text, sizeof text, menu_text(UI_NOTICE_ERROR), code, why);
+    } else {
+        snprintf(text, sizeof text, menu_text(UI_NOTICE_NO_NETWORK), why);
+    }
+    rt_log("net: notice: %s", text);
+    menu_notice(text, 10);
+}
+
+void net_host_boot(void) {
+    net_clients_start();
+    const char *started = getenv("MKW_HOST_STARTED");
+    if (!net_host_enabled() || (started && *started) || !net_host_available()) return;
+    char err[200];
+    if (net_host_start(err, sizeof err)) rt_log("net: the server did not start: %s", err);
+}
diff --git a/runtime/sdk/ov/net_invite.h b/runtime/sdk/ov/net_invite.h
new file mode 100644
index 0000000..e989fd6
--- /dev/null
+++ b/runtime/sdk/ov/net_invite.h
@@ -0,0 +1,71 @@
+// Server routing invites for private networks: no directory service, account secret or room state is encoded.
+// The checksum catches typing mistakes; it is not authentication. Access is controlled by the VPN and firewall.
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+static inline int net_invite_local(uint32_t ip) {
+    return (ip >> 24) == 10 || (ip >> 20) == 0xac1 || (ip >> 16) == 0xc0a8 ||
+           (ip >> 22) == 0x191 || (ip >> 24) == 127;
+}
+
+static inline unsigned net_invite_check(uint32_t ip, unsigned port) {
+    return (ip ^ (ip >> 16) ^ port ^ 0x4d4b) & 0xffff;
+}
+
+static inline int net_invite_make(uint32_t ip, unsigned port, char out[32]) {
+    out[0] = 0;
+    if (!net_invite_local(ip) || !port || port > 65533) return 0;
+    snprintf(out, 32, "MKW1-%08X-%04X-%04X", (unsigned)ip, port, net_invite_check(ip, port));
+    return 1;
+}
+
+static inline int net_invite_hex(const char *s, int count, uint32_t *value) {
+    *value = 0;
+    for (int i = 0; i < count; i++) {
+        unsigned char c = (unsigned char)s[i];
+        unsigned d = c >= '0' && c <= '9' ? c - '0' : c >= 'A' && c <= 'F' ? c - 'A' + 10 :
+                     c >= 'a' && c <= 'f' ? c - 'a' + 10 : 16;
+        if (d > 15) return 0;
+        *value = (*value << 4) | d;
+    }
+    return 1;
+}
+
+static inline int net_invite_parse(const char *text, char endpoint[32]) {
+    uint32_t ip, port, check;
+    endpoint[0] = 0;
+    if (!text || strlen(text) != 23 || strncmp(text, "MKW1-", 5) || text[13] != '-' || text[18] != '-' ||
+        !net_invite_hex(text + 5, 8, &ip) || !net_invite_hex(text + 14, 4, &port) ||
+        !net_invite_hex(text + 19, 4, &check) || !net_invite_local(ip) || !port || port > 65533 ||
+        check != net_invite_check(ip, port)) return 0;
+    snprintf(endpoint, 32, "%u.%u.%u.%u:%u", ip >> 24, (ip >> 16) & 255, (ip >> 8) & 255, ip & 255, port);
+    return 1;
+}
+
+// F1 also accepts a public server address. This checks syntax only; DNS and probing run on its worker.
+static inline int net_join_endpoint(const char *text, char endpoint[160]) {
+    endpoint[0] = 0;
+    if (!text || !*text || strlen(text) >= 160) return 0;
+    if (!strncmp(text, "MKW1-", 5)) return net_invite_parse(text, endpoint);
+    const char *colon = strchr(text, ':');
+    size_t host_len = colon ? (size_t)(colon - text) : strlen(text);
+    if (!host_len || host_len > 253 || text[0] == '.' || text[host_len - 1] == '.') return 0;
+    for (size_t i = 0; i < host_len; i++) {
+        unsigned char c = (unsigned char)text[i];
+        if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '.'))
+            return 0;
+    }
+    if (colon) {
+        unsigned port = 0;
+        if (!colon[1]) return 0;
+        for (const char *p = colon + 1; *p; p++) {
+            if (*p < '0' || *p > '9' || port > 6553) return 0;
+            port = port * 10 + (unsigned)(*p - '0');
+        }
+        if (!port || port > 65533) return 0;
+    }
+    memcpy(endpoint, text, strlen(text) + 1);
+    return 1;
+}
diff --git a/runtime/sdk/ov/net_listen.h b/runtime/sdk/ov/net_listen.h
new file mode 100644
index 0000000..21d66b7
--- /dev/null
+++ b/runtime/sdk/ov/net_listen.h
@@ -0,0 +1,49 @@
+// Integrated from Gael50/mkw-recomp @ 918bbd6523729cd18636c051a1e6e62101fd155f (MIT), PR #354.
+// When this PC's server should listen again (net_host.c net_host_listen_changed): the addresses of the network choice
+// differ from the ones it listens on, and for good. An address added counts once it has stayed NET_LISTEN_ADD_MS, one
+// gone once it has stayed gone NET_LISTEN_GONE_MS. Tailscale's adapter drops its address for seconds while it
+// reconnects (14/11/2026: 3 addresses, 2 seventeen seconds later, 3 again four seconds after): each change
+// restarted the server, which ended every player's session, and moved this PC's own game from Tailscale's address
+// to the box's.
+// No platform code: tests/c/t_net_listen.c builds it alone.
+#pragma once
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+
+enum { NET_LISTEN_ADD_MS = 5000, NET_LISTEN_GONE_MS = 30000 };
+
+typedef struct {
+    char seen[128];   // the address list that differs from the server's, as last seen
+    uint64_t since;   // when it was first seen
+} NetListenWatch;
+
+// 1 when "a,b,c" list now has an address that list running has not
+static inline int net_listen_added(const char *running, const char *now) {
+    for (const char *p = now; *p;) {
+        size_t n = strcspn(p, ",");
+        int found = 0;
+        for (const char *q = running; *q && !found;) {
+            size_t m = strcspn(q, ",");
+            found = m == n && !memcmp(p, q, n);
+            q += m + (q[m] == ',');
+        }
+        if (n && !found) return 1;
+        p += n + (p[n] == ',');
+    }
+    return 0;
+}
+
+// Called about once a second at time t (ms): 1 when the server listening on running should listen on now instead
+static inline int net_listen_settled(NetListenWatch *w, const char *running, const char *now, uint64_t t) {
+    if (!strcmp(running, now)) {   // back as it was, or never changed
+        w->seen[0] = 0;
+        return 0;
+    }
+    if (strcmp(w->seen, now)) {   // another list: its clock starts
+        snprintf(w->seen, sizeof w->seen, "%s", now);
+        w->since = t;
+        return 0;
+    }
+    return t - w->since >= (net_listen_added(running, now) ? NET_LISTEN_ADD_MS : NET_LISTEN_GONE_MS);
+}
diff --git a/runtime/sdk/ov/net_online.c b/runtime/sdk/ov/net_online.c
new file mode 100644
index 0000000..18cc1ef
--- /dev/null
+++ b/runtime/sdk/ov/net_online.c
@@ -0,0 +1,1035 @@
+// Integrated from Gael50/mkw-recomp @ 918bbd6523729cd18636c051a1e6e62101fd155f (MIT), PR #354.
+// Online play on a private server: settings, friend code, certificate and friends API (net_online.h).
+// Windows does the https of the friends API with WinHTTP; the server's own certificate is pinned (its CA is the only
+// root the chain may end in), checked before the request carries the friend code's secret.
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#include <windows.h>
+#include <wincrypt.h>
+#include <winhttp.h>
+#else
+#include <arpa/inet.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <poll.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "cfg.h"
+#include "net_online.h"
+#include "platform/platform.h"
+
+void rt_log(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+
+// Pia's NAT check servers (nncs1/nncs2) are under n.n.srv, its monitoring under p.srv; the game's NPLN services
+// under npln.srv. The server answers all of them.
+static const char *const kHosts[] = {"npln.srv.nintendo.net", "npln.nintendo.net", "n.n.srv.nintendo.net",
+                                     "p.srv.nintendo.net"};
+
+static void wsa_init(void) {
+#ifdef _WIN32
+    static volatile int done;
+    if (!done) {
+        WSADATA w;
+        WSAStartup(MAKEWORD(2, 2), &w);   // reference counted: a second start by another caller is harmless
+        done = 1;
+    }
+#endif
+}
+
+int net_enabled(void) {
+    const char *v = cfg_get("MKW_ONLINE");
+    return v && *v && strcmp(v, "0") != 0;
+}
+
+// "a.b.c.d[:port]" or "name[:port]"; never a Nintendo name, which the redirect would send back to Nintendo.
+static void parse_server(const char *text, NetServer *s) {
+    memset(s, 0, sizeof *s);
+    if (!text || !*text) return;
+    snprintf(s->text, sizeof s->text, "%s", text);
+    char host[160];
+    snprintf(host, sizeof host, "%s", text);
+    unsigned port = 8443;   // the server's online port when the setting has none (an address alone reached 443)
+    char *colon = strrchr(host, ':');
+    if (colon) {
+        port = (unsigned)strtoul(colon + 1, NULL, 10);
+        *colon = 0;
+    }
+    for (char *p = host; *p; p++) *p = (char)tolower((unsigned char)*p);
+    if (!*host || port == 0 || port > 65535 || strstr(host, "nintendo")) {
+        rt_log("net: online server \"%s\" is not <ipv4 or name>[:<port>]; online play is off", text);
+        return;
+    }
+    wsa_init();
+    struct addrinfo hints = {0}, *res = NULL;
+    hints.ai_family = AF_INET;
+    if (getaddrinfo(host, NULL, &hints, &res) || !res) {
+        rt_log("net: online server %s has no IPv4 address; online play is off", host);
+        return;
+    }
+    memcpy(s->ip, &((struct sockaddr_in *)res->ai_addr)->sin_addr, 4);
+    freeaddrinfo(res);
+    s->port = (uint16_t)port;
+    s->on = 1;
+}
+
+const NetServer *net_server(void) {
+    static NetServer s[2];
+    static volatile unsigned seen = ~0u;
+    static volatile int cur;
+    static PlatMutex lock = PLAT_MUTEX_INIT;
+    unsigned v = cfg_version();
+    if (v != seen) {
+        plat_mutex_lock(&lock);
+        if (v != seen) {
+            int next = !cur;
+            parse_server(net_enabled() ? cfg_get("MKW_ONLINE_SERVER") : NULL, &s[next]);
+            if (s[next].on)
+                rt_log("net: online server %s = %u.%u.%u.%u, its port 443 is %u", s[next].text, s[next].ip[0],
+                       s[next].ip[1], s[next].ip[2], s[next].ip[3], s[next].port);
+            cur = next;   // the other copy stays readable for a caller that took it before
+            seen = v;
+        }
+        plat_mutex_unlock(&lock);
+    }
+    return &s[cur];
+}
+
+int net_redirected_host(const char *host) {
+    if (!host || !net_server()->on) return 0;
+    size_t n = strlen(host);
+    if (n && host[n - 1] == '.') n--;   // an absolute name
+    for (size_t i = 0; i < sizeof kHosts / sizeof *kHosts; i++) {
+        size_t m = strlen(kHosts[i]);
+        if (n == m && !strncmp(host, kHosts[i], m)) return 1;
+        if (n > m && host[n - m - 1] == '.' && !strncmp(host + n - m, kHosts[i], m)) return 1;
+    }
+    return 0;
+}
+
+// The local address of the route toward the server (or toward a public address without one): a UDP connect sends
+// nothing, it only picks the route. Through Tailscale this is the 100.x address the other players reach.
+uint32_t net_local_ip(void) {
+    wsa_init();
+    const NetServer *s = net_server();
+    struct sockaddr_in to = {0}, me = {0};
+    to.sin_family = AF_INET;
+    to.sin_port = htons(s->on ? s->port : 53);
+    if (s->on) memcpy(&to.sin_addr, s->ip, 4);
+    else to.sin_addr.s_addr = htonl(0x08080808);
+    uint32_t ip = 0;
+#ifdef _WIN32
+    SOCKET fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (fd == INVALID_SOCKET) return 0;
+    int len = sizeof me;
+#else
+    int fd = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+    if (fd < 0) return 0;
+    socklen_t len = sizeof me;
+#endif
+    if (!connect(fd, (struct sockaddr *)&to, sizeof to) && !getsockname(fd, (struct sockaddr *)&me, &len))
+        ip = me.sin_addr.s_addr;
+#ifdef _WIN32
+    closesocket(fd);
+#else
+    close(fd);
+#endif
+    return ip;
+}
+
+// ---- the profile: <exe dir>/profile/online/<key>.txt, Droplet's format
+static int online_dir(char *out, size_t cap) {
+    char exe[1024];
+    if (!plat_exe_path(exe, sizeof exe)) return 0;
+    char *slash = strrchr(exe, '/'), *bs = strrchr(exe, '\\');
+    if (bs > slash) slash = bs;
+    if (!slash) return 0;
+    *slash = 0;
+    snprintf(out, cap, "%s/profile/online", exe);
+    return 1;
+}
+
+// This PC's own server written as one of its addresses ("192.168.1.10:8443", "100.x.y.z:8443", "127.0.0.1"):
+// its port, else 0. The address alone is enough: no name is resolved here.
+static unsigned this_pc_port(const char *server) {
+    char host[64];
+    snprintf(host, sizeof host, "%s", server ? server : "");
+    unsigned port = 8443;
+    char *colon = strrchr(host, ':');
+    if (colon) port = (unsigned)strtoul(colon + 1, NULL, 10), *colon = 0;
+    struct in_addr a;
+    wsa_init();
+    if (!port || port > 65535 || inet_pton(AF_INET, host, &a) != 1 || !net_is_this_pc(a.s_addr)) return 0;
+    return port;
+}
+
+static void profile_key(const char *server, char *out, size_t cap) {
+    // this PC's own server keeps one friend code whatever address it is played at (home network, Tailscale)
+    unsigned own = this_pc_port(server);
+    if (own) {
+        snprintf(out, cap, "ce-pc_%u", own);
+        return;
+    }
+    size_t n = 0;
+    for (const char *p = server; *p && n + 1 < cap; p++) {
+        char ch = (char)tolower((unsigned char)*p);
+        out[n++] = isalnum((unsigned char)ch) || ch == '.' || ch == '-' ? ch : '_';
+    }
+    out[n] = 0;
+    if (!n) snprintf(out, cap, "default");
+}
+
+static int profile_path(const char *server, const char *ext, char *out, size_t cap) {
+    char dir[1100], key[200];
+    if (!online_dir(dir, sizeof dir)) return 0;
+    profile_key(server, key, sizeof key);
+    snprintf(out, cap, "%s/%s%s", dir, key, ext);
+    return 1;
+}
+
+void net_format_code(const char *code, char out[18]) {
+    snprintf(out, 18, "SW-%.4s-%.4s-%.4s", code, code + 4, code + 8);
+}
+
+int net_parse_code(const char *text, char out[13]) {
+    int n = 0;
+    for (const char *p = text; p && *p; p++) {
+        if (isdigit((unsigned char)*p)) {
+            if (n == 12) return 0;
+            out[n++] = *p;
+        } else if (!(*p == '-' || *p == ' ' || ((*p == 'S' || *p == 's' || *p == 'W' || *p == 'w') && n == 0))) {
+            return 0;
+        }
+    }
+    out[n] = 0;
+    return n == 12 && strcmp(out, "000000000000") != 0;
+}
+
+static void parse_codes(const char *v, char (*codes)[13], int *n) {
+    *n = 0;
+    char buf[13];
+    while (v && *v && *n < NET_MAX_CODES) {
+        const char *comma = strchr(v, ',');
+        size_t len = comma ? (size_t)(comma - v) : strlen(v);
+        if (len == 12) {
+            memcpy(buf, v, 12);
+            buf[12] = 0;
+            if (net_parse_code(buf, codes[*n])) (*n)++;
+        }
+        v = comma ? comma + 1 : NULL;
+    }
+}
+
+static int new_profile(NetProfile *p) {
+    uint8_t r[24];
+    if (!plat_random(r, sizeof r)) return 0;
+    uint64_t v = 0;
+    memcpy(&v, r, 8);
+    snprintf(p->code, sizeof p->code, "%012llu", (unsigned long long)(v % 999999999999ull + 1));
+    for (int i = 0; i < 16; i++) snprintf(p->secret + 2 * i, 3, "%02x", r[8 + i]);
+    return 1;
+}
+
+// One profile file into *p: 1 when it holds a code and a secret
+static int profile_read(const char *path, NetProfile *p) {
+    memset(p, 0, sizeof *p);
+    uint64_t size = 0;
+    char *text = (char *)plat_file_read(path, &size);
+    if (!text) return 0;
+    char *line = text;
+    while (line && line < text + size) {
+        char *end = memchr(line, '\n', (size_t)(text + size - line));
+        if (end) *end = 0;
+        size_t len = strlen(line);
+        if (len && line[len - 1] == '\r') line[len - 1] = 0;
+        char *eq = strchr(line, '=');
+        if (eq) {
+            *eq = 0;
+            const char *v = eq + 1;
+            if (!strcmp(line, "code")) net_parse_code(v, p->code);
+            else if (!strcmp(line, "secret")) snprintf(p->secret, sizeof p->secret, "%s", v);
+            else if (!strcmp(line, "friends")) parse_codes(v, p->friends, &p->nfriends);
+            else if (!strcmp(line, "removed")) parse_codes(v, p->removed, &p->nremoved);
+            else if (!strcmp(line, "machine")) snprintf(p->machine, sizeof p->machine, "%s", v);
+        }
+        line = end ? end + 1 : NULL;
+    }
+    free(text);
+    if (p->code[0] && strlen(p->secret) >= 16) return 1;
+    rt_log("net: %s is damaged", path);
+    memset(p, 0, sizeof *p);
+    return 0;
+}
+
+int net_profile_load(const char *server, NetProfile *p, int create) {
+    memset(p, 0, sizeof *p);
+    char path[1400], dir[1100];
+    if (!server || !*server || !profile_path(server, ".txt", path, sizeof path)) return 0;
+    if (profile_read(path, p)) {
+        if (!p->machine[0]) return net_profile_save(server, p), 1;   // from before the mark: this PC's from now on
+        if (!strcmp(p->machine, net_machine_id())) return 1;
+        // A copied folder: this friend code is another PC's. Kept aside; this PC gets its own.
+        char aside[1450];
+        snprintf(aside, sizeof aside, "%s.autre-pc", path);
+        plat_file_replace(path, aside);
+        rt_log("net: %s was made on another PC (kept as %s): this PC gets its own friend code", path, aside);
+        memset(p, 0, sizeof *p);
+    }
+    // This PC's own server, first time under its own key: the friend code it had under one of its addresses, the
+    // old key ("a.b.c.d_<port>", or "a.b.c.d" for one written without its port, 8443 now). Tailscale's first (the one
+    // its friends know), then the home network's and 127.0.0.1's.
+    unsigned own = this_pc_port(server);
+    if (own && online_dir(dir, sizeof dir)) {
+        NetAddrs a;
+        net_addrs(&a);
+        const char *ips[3] = {a.ts, a.home, "127.0.0.1"};
+        for (int i = 0; i < 6; i++) {
+            const char *ip = ips[i / 2];
+            if (!ip[0] || ((i & 1) && own != 8443)) continue;
+            char old[1300];
+            if (i & 1) snprintf(old, sizeof old, "%s/%s.txt", dir, ip);
+            else snprintf(old, sizeof old, "%s/%s_%u.txt", dir, ip, own);
+            if (!plat_file_exists(old) || !profile_read(old, p)) continue;
+            if (p->machine[0] && strcmp(p->machine, net_machine_id())) continue;   // another PC's
+            if (!net_profile_save(server, p)) return 0;
+            char shown[18];
+            net_format_code(p->code, shown);
+            rt_log("net: this PC's server keeps friend code %s (from %s)", shown, old);
+            return 1;
+        }
+    }
+    if (!create || !new_profile(p)) return 0;
+    if (!net_profile_save(server, p)) return 0;
+    char shown[18];
+    net_format_code(p->code, shown);
+    rt_log("net: new friend code %s for %s (%s)", shown, server, path);
+    return 1;
+}
+
+static void join_codes(char *out, size_t cap, const char (*codes)[13], int n) {
+    size_t used = 0;
+    out[0] = 0;
+    for (int i = 0; i < n && used + 14 < cap; i++)
+        used += (size_t)snprintf(out + used, cap - used, "%s%s", i ? "," : "", codes[i]);
+}
+
+int net_profile_save(const char *server, const NetProfile *p) {
+    char path[1400], dir[1100];
+    if (!profile_path(server, ".txt", path, sizeof path) || !online_dir(dir, sizeof dir)) return 0;
+    plat_file_mkdir_p(dir);
+    static char friends[NET_MAX_CODES * 13 + 1], removed[NET_MAX_CODES * 13 + 1], text[4096];
+    static PlatMutex lock = PLAT_MUTEX_INIT;
+    plat_mutex_lock(&lock);
+    join_codes(friends, sizeof friends, p->friends, p->nfriends);
+    join_codes(removed, sizeof removed, p->removed, p->nremoved);
+    int n = snprintf(text, sizeof text, "server=%s\ncode=%s\nsecret=%s\nfriends=%s\nremoved=%s\nmachine=%s\n", server,
+                     p->code, p->secret, friends, removed, net_machine_id());
+    int ok = n > 0 && (size_t)n < sizeof text && plat_file_write_atomic(path, text, (size_t)n);
+    plat_mutex_unlock(&lock);
+    if (!ok) rt_log("net: could not save %s", path);
+    return ok;
+}
+
+// MKWOM login is restored without the Python setup. The DPAPI blob can only be
+// decrypted by the Windows user who completed setup; it is not a plaintext token.
+#ifdef _WIN32
+static int mkwom_game_ticket(const char *code, char *ticket, size_t cap) {
+    wchar_t path[MAX_PATH];
+    DWORD npath = GetModuleFileNameW(NULL, path, MAX_PATH);
+    if (!npath || npath >= MAX_PATH) { rt_log("mkwom: game session path unavailable"); return 0; }
+    wchar_t *slash = wcsrchr(path, L'\\');
+    if (!slash || (size_t)(slash - path) + 29 >= MAX_PATH) return 0;
+    wcscpy(slash + 1, L".mkwom\\account-session.dpapi");
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+    if (file == INVALID_HANDLE_VALUE) { rt_log("mkwom: saved game session unavailable (winerr=%lu)", GetLastError()); return 0; }
+    BYTE encrypted[2048];
+    DWORD got = 0, size = GetFileSize(file, NULL);
+    BOOL read_ok = size > 0 && size <= sizeof encrypted && ReadFile(file, encrypted, size, &got, NULL);
+    CloseHandle(file);
+    if (!read_ok || got != size) { rt_log("mkwom: saved session file unreadable or invalid size"); return 0; }
+    DATA_BLOB input = {size, encrypted}, output = {0};
+    if (!CryptUnprotectData(&input, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &output)) {
+        rt_log("mkwom: could not unlock saved Windows session (winerr=%lu)", GetLastError());
+        return 0;
+    }
+    char access[65] = {0};
+    int ok = 0;
+    size_t offset = (output.cbData == 73 && !memcmp(output.pbData, "pre-beta\n", 9)) ? 9 : (output.cbData == 69 && !memcmp(output.pbData, "beta\n", 5)) ? 5 : (output.cbData == 72 && !memcmp(output.pbData, "release\n", 8)) ? 8 : 0;
+    if (offset) { memcpy(access, output.pbData + offset, 64);
+        ok = 1;
+        for (int i = 0; i < 64; i++)
+            if (!((access[i] >= '0' && access[i] <= '9') || (access[i] >= 'a' && access[i] <= 'f'))) ok = 0;
+    }
+    SecureZeroMemory(output.pbData, output.cbData);
+    LocalFree(output.pbData);
+    SecureZeroMemory(encrypted, sizeof encrypted);
+    if (!ok) { rt_log("mkwom: saved Windows session has an invalid format"); return 0; }
+    ok = 0;  // A valid local token is NOT a successful remote login.
+    HINTERNET ses = WinHttpOpen(L"MKWOM/0.1", WINHTTP_ACCESS_TYPE_DEFAULT_PROXY,
+                                WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0);
+    HINTERNET con = ses ? WinHttpConnect(ses, L"mkwom-api.liliananuzohra.com", 443, 0) : NULL;
+    HINTERNET req = con ? WinHttpOpenRequest(con, L"POST", L"/game-ticket", NULL, WINHTTP_NO_REFERER,
+                                              WINHTTP_DEFAULT_ACCEPT_TYPES, WINHTTP_FLAG_SECURE) : NULL;
+    char body[128];
+    // The installed DPAPI session carries the chosen channel.
+    const char *ticket_channel = offset == 5 ? "beta" : offset == 8 ? "release" : NULL;
+    int body_n = ticket_channel
+        ? snprintf(body, sizeof body, "{\"friend_code\":\"%s\",\"channel\":\"%s\"}", code, ticket_channel)
+        : snprintf(body, sizeof body, "{\"friend_code\":\"%s\"}", code);
+    wchar_t headers[256];
+    swprintf(headers, sizeof headers / sizeof *headers,
+             L"Content-Type: application/json\r\nAuthorization: Bearer %hs\r\n", access);
+    SecureZeroMemory(access, sizeof access);
+    if (!req || body_n <= 0 || body_n >= (int)sizeof body) goto close;
+    WinHttpSetTimeouts(req, 3000, 3000, 5000, 5000);
+    DWORD reject_redirect = WINHTTP_DISABLE_REDIRECTS;
+    WinHttpSetOption(req, WINHTTP_OPTION_DISABLE_FEATURE, &reject_redirect, sizeof reject_redirect);
+    if (!WinHttpSendRequest(req, headers, (DWORD)-1L, body, (DWORD)body_n, (DWORD)body_n, 0)) {
+        rt_log("mkwom: account ticket request send failed (winerr=%lu)", GetLastError());
+        goto close;
+    }
+    if (!WinHttpReceiveResponse(req, NULL)) {
+        rt_log("mkwom: account ticket response failed (winerr=%lu)", GetLastError());
+        goto close;
+    }
+    DWORD status = 0, sl = sizeof status;
+    if (!WinHttpQueryHeaders(req, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                             NULL, &status, &sl, NULL)) {
+        rt_log("mkwom: account ticket HTTP status unavailable (winerr=%lu)", GetLastError());
+        goto close;
+    }
+    if (status != 200) {
+        rt_log("mkwom: account ticket HTTP status %lu (credentials or API configuration)", status);
+        goto close;
+    }
+    char reply[512] = {0};
+    DWORD bytes = 0;
+    if (!WinHttpReadData(req, reply, sizeof reply - 1, &bytes) || !bytes) goto close;
+    const char *p = strstr(reply, "\"ticket\":\"");
+    if (!p) { rt_log("mkwom: account API response omitted ticket"); goto close; }
+    p += 10;
+    const char *q = strchr(p, '"');
+    if (!q || q - p < 100 || (size_t)(q - p) >= cap) goto close;
+    for (const char *x = p; x < q; x++)
+        if (!((*x >= '0' && *x <= '9') || (*x >= 'a' && *x <= 'z') ||
+              *x == '.')) goto close;
+    memcpy(ticket, p, (size_t)(q - p));
+    ticket[q - p] = 0;
+    ok = 1;
+close:
+    SecureZeroMemory(headers, sizeof headers);
+    if (req) WinHttpCloseHandle(req);
+    if (con) WinHttpCloseHandle(con);
+    if (ses) WinHttpCloseHandle(ses);
+    return ok;
+}
