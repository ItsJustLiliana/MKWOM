+    shutil.rmtree(glslc, ignore_errors=True)
+    for name in ("shaderc", "glslang", "spirv-tools", "libstdcxx", "libgcc", "vc14_runtime"):
+        if name in got:
+            unpack_conda(got[name], glslc)
+    if args.target == "windows":
