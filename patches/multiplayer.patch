+def sign_in(h: H2, sid: int, code: str, secret: str) -> None:
+    ident = f"droplet-online-v1;code={code};secret={secret};friends="
+    call(h, sid, SIGN_IN, pb(1, f"tenants/{TENANT}") + pb(3, pb(1, ident)))
+
