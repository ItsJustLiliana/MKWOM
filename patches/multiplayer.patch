-    if not path.is_file():
-        print(f"get {url}", flush=True)
-        part = path.with_suffix(path.suffix + ".part")
-        with urllib.request.urlopen(url) as r, part.open("wb") as f:
-            shutil.copyfileobj(r, f)
-        part.rename(path)
-    got = sha256(path)
-    if got != want:
-        sys.exit(f"{path.name}: sha256 {got}, expected {want}")
-    return path
