+// MKW_OPERATION_MODE, read once: 1 handheld (OperationMode 0, PerformanceMode Normal 0), 0 docked (1, Boost 1).
+int ov_handheld(void) {
+    static volatile int32_t v = -1;
+    int32_t h = v;
+    if (h < 0) {
+        const char *e = cfg_value("MKW_OPERATION_MODE");
