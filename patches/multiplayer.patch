-    const char *menu = cfg_get("MKW_MENU_LANG");
-    if (!menu || !*menu || (!strcmp(menu, "en") && !strncmp(tag, "en", 2))) return tag;
-    if (strcmp(menu, "en") && !strcmp(switch_language(menu), "en-US")) return tag;   // uk; pl, th before 1.5/1.7
-    return menu;
-}
