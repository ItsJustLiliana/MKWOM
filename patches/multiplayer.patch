-    // connected; Linux reports those only on connected sockets, and Pia never connects. Off, as Linux behaves
-    // (SIO_UDP_CONNRESET, Microsoft's KB263823).
-    if ((type & ~B_SOCK_FLAGS) == SOCK_DGRAM) {
