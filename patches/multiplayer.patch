diff --git a/runtime/input/input_sdl.h b/runtime/input/input_sdl.h
index 5d029e9..0e1e021 100644
--- a/runtime/input/input_sdl.h
+++ b/runtime/input/input_sdl.h
@@ -1,25 +1,26 @@
-// The SDL3 window's input seams (Linux and other hosts without Win32): gfx_window_sdl.c owns the window and its event
