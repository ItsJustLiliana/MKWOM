+// ---- the VP9 decoder: three 64x64 frames of flat grey levels, then the end of stream
+enum { W = 64, H = 64, FRAMES = 3 };
+
+// The probe's input: frame k is luma 40 + 60k with neutral chroma, one packet each (no lag).
+static int encode(uint8_t *pkts[FRAMES], size_t sizes[FRAMES]) {
+    vpx_codec_enc_cfg_t cfg;
+    vpx_codec_ctx_t enc;
+    if (vpx_codec_enc_config_default(vpx_codec_vp9_cx(), &cfg, 0)) return 0;
+    cfg.g_w = W, cfg.g_h = H, cfg.g_lag_in_frames = 0, cfg.rc_target_bitrate = 2000, cfg.g_timebase = (vpx_rational_t){1, 30};
+    if (vpx_codec_enc_init(&enc, vpx_codec_vp9_cx(), &cfg, 0)) return 0;
+    vpx_image_t img;
+    vpx_img_alloc(&img, VPX_IMG_FMT_I420, W, H, 1);
+    int got = 0;
+    for (int k = 0; k < FRAMES; k++) {
+        for (int y = 0; y < H; y++) memset(img.planes[0] + y * img.stride[0], 40 + 60 * k, W);
+        for (int y = 0; y < H / 2; y++) {
+            memset(img.planes[1] + y * img.stride[1], 128, W / 2);
+            memset(img.planes[2] + y * img.stride[2], 128, W / 2);
+        }
+        if (vpx_codec_encode(&enc, &img, k, 1, 0, VPX_DL_GOOD_QUALITY)) break;
+        vpx_codec_iter_t it = NULL;
+        const vpx_codec_cx_pkt_t *p;
+        while ((p = vpx_codec_get_cx_data(&enc, &it)))
+            if (p->kind == VPX_CODEC_CX_FRAME_PKT && got < FRAMES) {
+                pkts[got] = malloc(p->data.frame.sz);
+                memcpy(pkts[got], p->data.frame.buf, p->data.frame.sz);
+                sizes[got++] = p->data.frame.sz;
+            }
+    }
+    vpx_img_free(&img);
+    vpx_codec_destroy(&enc);
+    return got == FRAMES;
+}
+
+static int mean(const uint8_t *p, size_t n) {
+    uint64_t s = 0;
+    for (size_t i = 0; i < n; i++) s += p[i];
+    return (int)(s / n);
+}
+
+// Submit until accepted: busy is answered while three frames wait for a slot
+static uint32_t submit(uint64_t dec, const void *data, size_t size, int64_t pts, int eos) {
+    uint64_t *consumed = ovp_alloc(16);
+    for (int tries = 0; tries < 200; tries++) {
+        uint32_t r = (uint32_t)CALL("codec::SubmitVp9DecoderInputBuffer", U(consumed), dec, U(data), size, (uint64_t)pts,
+                                    (uint64_t)eos);
+        if (r != R_BUSY) return r;
+        plat_sleep_ms(5);
+    }
+    return R_BUSY;
+}
+
+static void probe_codec(void) {
+    uint8_t *pkts[FRAMES] = {0};
+    size_t sizes[FRAMES] = {0};
+    if (!encode(pkts, sizes)) {
+        CHECK(0, "codec: libvpx could not encode the probe's frames");
+        return;
+    }
+    CHECK(CALL("codec::video::Initialize", 0) == 0, "video::Initialize");
+    // two image pools, one per slot, as the player makes them
+    uint8_t *pref = ovp_alloc(64), *pref2 = ovp_alloc(64);
+    ovp_call_full("codec::MakeDecodeImagePreference", (const uint64_t[8]){W, H, 1, 0}, U(pref), NULL, 0);
+    ovp_call_full("codec::sdk::MakeDecodeImagePreferenceForCompat", (const uint64_t[8]){W, H, 1, 0}, U(pref2), NULL, 0);
+    uint16_t pw, ph;
+    memcpy(&pw, pref, 2), memcpy(&ph, pref + 2, 2);
+    CHECK(pw == W && ph == H && !memcmp(pref, pref2, 16), "decode image preference %ux%u", pw, ph);
+    uint64_t *sz = ovp_alloc(16);
+    CHECK(CALL("codec::CalculateDecoderImagePoolBuffer", U(sz), U(sz + 1), U(pref), 1) == 0 && sz[0] >= W * H * 3 / 2 &&
+              sz[1] == 0x1000, "image pool size %#llx align %#llx", (unsigned long long)sz[0], (unsigned long long)sz[1]);
+    uint64_t pools[2];
+    for (int i = 0; i < 2; i++) {
+        pools[i] = U(ovp_alloc(0x40));
+        CHECK(CALL("codec::InitializeDecoderImagePool", pools[i], U(ovp_alloc(sz[0])), sz[0], U(pref), 1, 0) == 0,
+              "InitializeDecoderImagePool %d", i);
+    }
+    CHECK(CALL("codec::GetDecoderImagePoolNativeImageHandle", pools[0], 0) == 0, "native image handle (GPU mode)");
+    CHECK(CALL("codec::CalculateVp9DecoderWorkBuffer", U(sz), U(sz + 1), 0, W, H) == 0 && sz[0], "VP9 work buffer");
+
+    // one decoder through each Initialize overload; the second is only initialized and finalized
+    uint64_t dec = U(ovp_alloc(0x100)), dec2 = U(ovp_alloc(0x100));
+    const uint64_t stack[1] = {0};   // the output format, ninth argument
+    CHECK(ovp_call_full("codec::InitializeVp9Decoder(work)", (const uint64_t[8]){dec, U(ovp_alloc(sz[0])), sz[0], 0, W, H,
+                                                                                  2, 0}, 0, stack, 1) == 0,
+          "InitializeVp9Decoder with a work buffer");
+    CHECK(CALL("codec::InitializeVp9Decoder", dec2, 0, 0, W, H, 2, 0, 0) == 0, "InitializeVp9Decoder");
+    CHECK(CALL("codec::FinalizeVp9Decoder", dec2) == 0, "FinalizeVp9Decoder of the second decoder");
+    for (int i = 0; i < 2; i++)
+        CHECK(CALL("codec::RegisterVp9DecoderBuffer", dec, (uint64_t)i, pools[i], 0) == 0, "RegisterVp9DecoderBuffer %d", i);
+    CHECK(CALL("codec::StartVp9Decoder", dec) == 0, "StartVp9Decoder");
+    uint64_t *ready = ovp_alloc(16);
+    CHECK(CALL("codec::GetVp9DecoderSubmissionReadyEvent", U(ready), dec) == 0 && *ready, "submission ready event");
+
+    // the sync point event the player waits on for each acquired frame
+    uint64_t sp = U(ovp_alloc(0x40));
+    CALL("syncpt::sdk::CreateSyncPointEvent", sp);
+    CALL("syncpt::sdk::InitializeMultiWaitHolder", U(ovp_alloc(0x100)), sp);
+
+    uint8_t *luma = ovp_alloc(W * H), *chroma = ovp_alloc(W * H / 2);
+    uint64_t *handle = ovp_alloc(16);
+    uint32_t *slot = ovp_alloc(16);
+    // as the player: the frames submitted ahead of it, the end of stream while it still holds a picture
+    for (int k = 0; k < FRAMES; k++) CHECK(submit(dec, pkts[k], sizes[k], 1000 * k, 0) == 0, "Submit %d", k);
+    int good = 0;
+    for (int k = 0; k <= FRAMES; k++) {   // k == FRAMES: the end of stream, the last picture again
+        int eos = k == FRAMES;
+        CHECK(CALL("codec::AcquireVp9DecoderOutputBuffer", U(slot), U(handle), dec) == 0 && *slot < 2,
+              "Acquire %d: slot %u", k, *slot);
+        CALL("syncpt::sdk::RequestSyncPointEvent", sp, U(handle));
+        int done = 0;
+        for (int t = 0; t < 400 && !done; t++)
+            if (!(done = (int)(CALL("syncpt::sdk::TryWaitSyncPointEvent", sp) & 1))) plat_sleep_ms(5);
+        CHECK(done, "frame %d: the sync point event was not signalled in 2 s", k);
+        // 1.8.0's poll of the same handle: done once the frame is decoded, not for a frame further on
+        uint64_t *ahead = ovp_alloc(16);
+        ahead[0] = handle[0], ahead[1] = handle[1] + 1000;
+        CHECK((CALL("syncpt::sdk::TryWaitSyncPoint", U(handle)) & 1) && !(CALL("syncpt::sdk::TryWaitSyncPoint", U(ahead)) & 1),
+              "frame %d: TryWaitSyncPoint", k);
+        uint16_t *dims = ovp_alloc(16);
+        int64_t *pts = ovp_alloc(16);
+        uint8_t *eos_out = ovp_alloc(16);
+        const uint64_t props_stack[1] = {*slot};
+        ovp_call_full("codec::GetVp9DecoderOutputBufferProperties",
+                      (const uint64_t[8]){U(dims), U(dims + 1), U(dims + 2), U(dims + 3), U(ovp_alloc(16)), U(pts),
+                                          U(eos_out), dec}, 0, props_stack, 1);
+        CHECK(dims[0] == W && dims[1] == H && *pts == 1000 * k && *eos_out == eos,
+              "frame %d properties: %ux%u pts %lld eos %u", k, dims[0], dims[1], (long long)*pts, *eos_out);
+        const uint64_t read_stack[4] = {W * H, U(chroma), W, W * H / 2};
+        CHECK(ovp_call_full("codec::ReadDecoderOutputImageNv12", (const uint64_t[8]){pools[*slot], 0, 0, 0, W, H, U(luma), W},
+                            0, read_stack, 4) == 0, "ReadDecoderOutputImageNv12 %d", k);
+        int want = 40 + 60 * (eos ? FRAMES - 1 : k), y = mean(luma, W * H), c = mean(chroma, W * H / 2);
+        int ok = abs(y - want) <= 4 && abs(c - 128) <= 4;
+        CHECK(ok, "frame %d: mean luma %d (want %d), chroma %d", k, y, want, c);
+        good += ok;
+        if (k == 0) CHECK(submit(dec, NULL, 0, 1000 * FRAMES, 1) == 0, "Submit the end of stream");
+        CHECK(CALL("codec::ReleaseVp9DecoderOutputBuffer", dec, *slot, handle[0], handle[1]) == 0, "Release %d", k);
+    }
+    CALL("syncpt::sdk::CancelSyncPointEvent", sp);
+    CALL("syncpt::sdk::DestroySyncPointEvent", sp);
+    CHECK(CALL("codec::FlushVp9Decoder", dec) == 0, "FlushVp9Decoder");
+    CHECK(CALL("codec::StopVp9Decoder", dec) == 0, "StopVp9Decoder");
+    CHECK(CALL("codec::FinalizeVp9Decoder", dec) == 0, "FinalizeVp9Decoder");
+    for (int i = 0; i < 2; i++) CHECK(CALL("codec::FinalizeDecoderImagePool", pools[i]) == 0, "FinalizeDecoderImagePool");
+    CHECK(CALL("codec::video::Finalize", 0) == 0, "video::Finalize");
+    for (int k = 0; k < FRAMES; k++) free(pkts[k]);
+    printf("codec: VP9 %dx%d, %d of %d pictures (and the end of stream) decoded with their grey level, through image "
+           "pools, slots, sync point events and NV12 reads\n", W, H, good, FRAMES + 1);
+}
+
+// ---- socket (ov_socket.c): datagrams over the host's loopback with the console's sockaddr, flags and errno, an
+// empty nonblocking read, poll, eventfd, and every overload once
+static void probe_socket(void) {
+    enum { AF = 2, DGRAM = 2, UDP = 17, NONBLOCK = 2 << 28, SOL = 0xffff, EAGAIN_ = 11, EBADF_ = 9 };
+    uint8_t *b = ovp_alloc(0x400);
+    uint8_t *ab = b, *aa = b + 0x10, *from = b + 0x20, *buf = b + 0x40;
+    uint32_t *fromlen = (uint32_t *)(b + 0x80), *one = (uint32_t *)(b + 0x84);
+    uint64_t *val = (uint64_t *)(b + 0x88);
+    int32_t *pfd = (int32_t *)(b + 0x90);
+    void **res = (void **)(b + 0xb0);
+    plat_setenv("MKW_LAN", "1");   // off, probe_offline's table checks main's stub
+    CALL("socket::SetAllocator", 0);
+    CHECK(CALL("socket::internal::Initialize", 4) == 0, "Initialize");
+    CHECK(CALL("socket::IsInitialized") == 1, "IsInitialized");
+    int sa = (int)CALL("socket::Socket(int)", AF, DGRAM, UDP);
+    int sb = (int)CALL("socket::Socket", AF, DGRAM | NONBLOCK, UDP);
+    CHECK(sa >= 0 && sb >= 0 && sa != sb, "Socket: %d %d", sa, sb);
+    *one = 1;
+    CHECK((int)CALL("socket::SetSockOpt", sb, SOL, 0x4, U(one), 4) == 0, "SetSockOpt SO_REUSEADDR");
+    CHECK((int)CALL("socket::SetSockOpt", sa, SOL, 0x20, U(one), 4) == 0, "SetSockOpt SO_BROADCAST");
+    CHECK((int)CALL("socket::SetSockOpt", sa, SOL, 0x1015, U(one), 4) == 0, "SetSockOpt unmapped option accepted");
+    // FreeBSD sockaddr_in: len, family, port (big endian), 127.0.0.1; a free port from 47000
+    const uint8_t lo[4] = {127, 0, 0, 1};
+    int port = 0;
+    for (int p = 47000; p < 47040 && !port; p++) {
+        memset(ab, 0, 16);
+        ab[0] = 16, ab[1] = AF, ab[2] = (uint8_t)(p >> 8), ab[3] = (uint8_t)p;
+        memcpy(ab + 4, lo, 4);
+        if ((int)CALL("socket::Bind(sockaddr)", sb, U(ab), 16) == 0) port = p;
+    }
+    memset(aa, 0, 16);
+    aa[0] = 16, aa[1] = AF;
+    memcpy(aa + 4, lo, 4);
+    CHECK(port && (int)CALL("socket::Bind", sa, U(aa), 16) == 0, "Bind: port %d", port);
+    // nothing to read: -1 and EAGAIN, on the nonblocking socket and with MSG_DONTWAIT on the blocking one
+    *fromlen = 16;
+    CHECK((int64_t)CALL("socket::RecvFrom(sockaddr)", sb, U(buf), 64, 0, U(from), U(fromlen)) == -1 &&
+              CALL("socket::GetLastErrno") == EAGAIN_, "RecvFrom on an empty nonblocking socket");
+    CHECK((int64_t)CALL("socket::RecvFrom", sa, U(buf), 64, 0x80, U(from), U(fromlen)) == -1 &&
+              CALL("socket::GetLastError") == EAGAIN_, "RecvFrom with MSG_DONTWAIT");
+    memcpy(buf, "hello", 5);
+    CHECK((int64_t)CALL("socket::SendTo(sockaddr)", sa, U(buf), 5, 0, U(ab), 16) == 5, "SendTo");
+    pfd[0] = sb, pfd[1] = 1;     // events POLLIN, revents 0
+    pfd[2] = 63, pfd[3] = 1;     // a descriptor never opened
+    int n = (int)CALL("socket::Poll", U(pfd), 2, 1000);
+    CHECK(n == 2 && (pfd[1] >> 16 & 1) && (pfd[3] >> 16) == 0x20, "Poll: %d ready, revents %#x %#x", n,
+          (uint32_t)pfd[1] >> 16, (uint32_t)pfd[3] >> 16);
+    memset(buf, 0, 8);
+    memset(from, 0xee, 16);
+    *fromlen = 16;
+    int64_t got = (int64_t)CALL("socket::RecvFrom(sockaddr)", sb, U(buf), 64, 0, U(from), U(fromlen));
+    CHECK(got == 5 && !memcmp(buf, "hello", 5) && from[0] == 16 && from[1] == AF && !memcmp(from + 4, lo, 4) &&
+              *fromlen == 16, "RecvFrom: %lld bytes, from len %u family %u", (long long)got, from[0], from[1]);
+    CHECK((int64_t)CALL("socket::SendTo", sa, U(buf), 3, 0x80, U(ab), 16) == 3, "SendTo with MSG_DONTWAIT");
+    *fromlen = 16;
+    CHECK((int64_t)CALL("socket::RecvFrom", sb, U(buf), 64, 0, U(from), U(fromlen)) == 3, "RecvFrom 2");
+    // LAN only: an internet address is refused before anything is sent (8.8.8.8:53, a public one), and so is a bind to it
+    const uint8_t pub[4] = {8, 8, 8, 8};
+    memset(from, 0, 16);
+    from[0] = 16, from[1] = AF, from[3] = 53;
+    memcpy(from + 4, pub, 4);
+    CHECK((int64_t)CALL("socket::SendTo", sa, U(buf), 3, 0, U(from), 16) == -1 && CALL("socket::GetLastErrno") == 101,
+          "SendTo an internet address: refused, ENETUNREACH");
+    CHECK((int)CALL("socket::Bind", sb, U(from), 16) == -1 && CALL("socket::GetLastErrno") == 101,
+          "Bind to an internet address: refused");
+    int sh = (int)CALL("socket::Shutdown", sa, 2);   // a datagram socket with no peer: 0, or ENOTCONN (107)
+    CHECK(sh == 0 || CALL("socket::GetLastErrno") == 107, "Shutdown: %d", sh);
+#ifndef _WIN32
+    int e = (int)CALL("socket::EventFd", 0, 4);
+    *val = 0;
+    CHECK(e >= 0 && (int)CALL("socket::EventFdWrite", e, 3) == 0 && (int)CALL("socket::EventFdRead", e, U(val)) == 0 &&
+              *val == 3, "EventFd: %d, read %llu", e, (unsigned long long)*val);
+    CHECK((int)CALL("socket::Close", e) == 0, "Close eventfd");
+#else
+    CHECK((int)CALL("socket::EventFd", 0, 4) == -1 && (int)CALL("socket::EventFdWrite", 0, 1) == -1 &&
+              (int)CALL("socket::EventFdRead", 0, U(val)) == -1, "EventFd unsupported on Windows");
+#endif
+    CHECK((int)CALL("socket::Close", sa) == 0 && (int)CALL("socket::Close", sb) == 0, "Close");
+    CHECK((int)CALL("socket::Close", sa) == -1 && CALL("socket::GetLastErrno") == EBADF_, "Close twice: EBADF");
+    *res = b;
+    CHECK(CALL("socket::GetAddrInfo(addrinfo)", U("example.com"), 0, 0, U(res)) != 0 && !*res, "GetAddrInfo offline");
+    CHECK(CALL("socket::GetAddrInfo", U("example.com"), 0, 0, U(res)) != 0, "GetAddrInfo (AddrInfo)");
+    CALL("socket::FreeAddrInfo(addrinfo)", 0);
+    CALL("socket::FreeAddrInfo", 0);
+    CHECK(CALL("socket::Finalize") == 0, "Finalize");
+    plat_setenv("MKW_LAN", "");
+    CHECK((int)CALL("socket::Socket(int)", AF, DGRAM, UDP) == -1 && CALL("socket::GetLastErrno") == 50,
+          "MKW_LAN off again: Socket -1, ENETDOWN");
+    printf("socket: UDP on loopback port %d through the console's sockaddr, poll, EAGAIN and eventfd\n", port);
+}
+
+void probe_mkw_services(void) {
+    probe_offline();
+    probe_online_ldn_initialize();
+    probe_online_tailscale_mask();
+    probe_account_mkw();
+    probe_system_mkw();
+    probe_codec();
+    probe_socket();
+}
diff --git a/runtime/sdk/fs/romfs.c b/runtime/sdk/fs/romfs.c
index dfc050a..676ea62 100644
--- a/runtime/sdk/fs/romfs.c
+++ b/runtime/sdk/fs/romfs.c
@@ -1,858 +1,884 @@
-// Adapted from MacNativeGames games/totk/runtime/romfs.c @ b75be8cf (MIT, Copyright (c) 2026 MacNativeGames
-// contributors).
-// Read-only game RomFS: the dump's loose romfs/ directory (rt_config()->romfs), walked at fs_init into an in-memory
-// index of paths and sizes; each file is opened by its host path when the game opens it. Or, when rt_config()->romfs
-// is a packed dump (pack.h: .nup or .nx), the index comes from its table of contents: a .nup raw file is read in place at
-// its offset in the package (one shared handle), a .nup zstd file is decompressed whole into memory when the game opens
-// it (one frame per file: no way to start in the middle), a .nx file is read at any offset through its blocks. Reads are
-// positional (platform.h plat_file_pread), so threads read in parallel without a file-pointer lock. totk-pc-recomp's packed
-// romfs.bin (its index, SHA-256 proof and mapping) has no MKW counterpart.
-//
-// Overlays: files listed in a directory's manifest.tsv are served in place of the originals. Each line names a RomFS
-// path, the overlay's size and SHA-256 and the original's SHA-256 ("-" adds a file the RomFS lacks; it is numbered
-// after the RomFS's own files, file_count + k in path order). The directories, in this order: MKW_ROMFS_PATCHES and
-// MKW_ROMFS_MODS; unset or "0" = none; then <game dir>/lang/<code>/ for a language the game does not ship
-// (ov_text_language: its texts rebuilt by the setup, tools/i18n/game_texts.py). A missing path, a size or hash mismatch
-// or a changed original stops the start.
-// An overlay file is opened when the game opens it; its identity (volume, file id, size, last write) is kept from the
-// start check, and an open that finds another file there stops the game.
-#include <stdio.h>
-#include <limits.h>
-#include <stdlib.h>
-#include <string.h>
-
-#include "cfg.h"
-#include "fs.h"
-#include "host.h"
-#include "pack.h"
-#include "ov.h"
-#include "romfs_path.h"
-#include "platform/platform.h"
-#include "sha256.h"
-
-#define NH 65536                     // RomFS handle slots
-#define READ_CHUNK (64u << 20)       // largest single read
-#define HASH_CHUNK (8u << 20)
-#define ADDED UINT64_MAX             // an added overlay file's index until overlay_init numbers it
-
-typedef struct { uint64_t offset, size; uint32_t name, len; } Entry;
-_Static_assert(sizeof(Entry) == 24, "index entry layout");
-
-typedef struct { uint32_t volume, pad; uint64_t file_id, size, write_time, create_time; } Identity;   // no padding
-typedef struct { uint64_t index, size; char *path, *name; Identity id; unsigned ord; } Overlay;
-
-static uint8_t *index_bytes;
-static size_t index_size;
-static uint64_t file_count, strings_offset;
-static char loose_root[2048];   // the loose folder or the package (load_loose_index, load_package_index)
-static char mount_name[32];
-static PlatMutex lock = PLAT_MUTEX_INIT;
-static uint64_t handles[NH];         // file index + 1; 0 is free
-static uint32_t handle_ovl[NH];      // overlay slot + 1 of an open handle, 0 = original
-static PlatFile *handle_file[NH];    // the handle's open file: an overlay's, a loose file's or the shared package
-static uint64_t handle_base[NH];     // where the file starts in handle_file (a package's raw file), else 0
-static uint8_t *handle_mem[NH];      // a .nup zstd file, decompressed at open (handle_file NULL)
-static Pack *package;                // the RomFS is a packed dump; its rows are package_rows, in index order
-static const PackEntry *package_rows;
-static Overlay *overlays;            // sorted by RomFS index after overlay_init
-static size_t noverlay, overlay_cap;
-static unsigned load_seq;            // overlay_load call count: later dirs win shared files
-static char **added;                 // RomFS paths of the added files, sorted; added[k] is index file_count + k
-static size_t nadded;
-
-static void need(int c, const char *m) {
-    if (!c) rt_fatal("RomFS: %s", m);
-}
-
-static Entry entry(uint64_t i) {
-    Entry e;
-    memcpy(&e, index_bytes + 24 + i * 24, 24);
-    return e;
-}
-static const char *entry_name(Entry e) { return (const char *)index_bytes + strings_offset + e.name; }
-
-static double now_s(void) { return (double)plat_now_ns() / 1e9; }
-
-// ---- positional reads
-// Bytes read at off (0 at or past the end of the file), -1 on an I/O error.
-static int64_t read_at(PlatFile *f, void *buf, uint32_t n, uint64_t off) {
-    mem_thaw((uintptr_t)buf, n);   // the kernel's write would fail on a frozen page instead of faulting
-    int64_t got = plat_file_pread(f, buf, n, off);
-    if (got == -2)   // a read-only page in the buffer: a frozen region missed its thaw
-        rt_log("RomFS: read of %u bytes into %p refused: the buffer is not writable", n, buf);
-    return got < 0 ? -1 : got;
-}
-
-static PlatFile *open_read(const char *path) { return plat_file_open(path); }
-
-static Identity identity_of(PlatFile *f) {
-    PlatFileId i;
-    need(plat_file_id(f, &i), "file information");
-    return (Identity){(uint32_t)i.volume, 0, i.file_id, i.size, i.write_time, i.create_time};
-}
-
-// ---- SHA-256 over a file range, streaming
-static void hex32(const uint8_t d[32], char out[65]) {
-    for (int i = 0; i < 32; i++) snprintf(out + 2 * i, 3, "%02x", d[i]);
-}
-
-static void sha_range(PlatFile *f, uint64_t offset, uint64_t size, char hex[65], int progress) {
-    Sha256 h;
-    sha256_init(&h);
-    uint8_t *buf = malloc(HASH_CHUNK);
-    need(buf != NULL, "hash buffer");
-    double t0 = now_s();
-    for (uint64_t done = 0; done < size;) {
-        uint32_t want = size - done > HASH_CHUNK ? HASH_CHUNK : (uint32_t)(size - done);
-        int64_t n = read_at(f, buf, want, offset + done);
-        need(n > 0, "read of hash input");
-        sha256_update(&h, buf, (size_t)n);
-        done += (uint64_t)n;
-        if (progress && (done % (2ull << 30) < (uint64_t)n || done == size))
-            rt_log("RomFS: hashed %.1f of %.1f GiB (%.0f MiB/s)", done / 1073741824.0, size / 1073741824.0,
-                   done / 1048576.0 / (now_s() - t0 + 1e-9));
-    }
-    uint8_t d[32];
-    sha256_final(&h, d);
-    free(buf);
-    hex32(d, hex);
-}
-
-static PlatFile *row_open(uint64_t i, uint64_t *base, uint8_t **mem);
-
-// SHA-256 of RomFS row i's original bytes.
-static void sha_row(uint64_t i, char hex[65]) {
-    uint64_t base;
-    uint8_t *mem = NULL;
-    PlatFile *f = row_open(i, &base, &mem);
-    if (!f && !mem && package) mem = pack_read_whole(package, &package_rows[i]);   // a .nx row
-    if (!f && !mem) rt_fatal("RomFS: %s unreadable", entry_name(entry(i)));
-    if (mem) {
-        uint8_t d[32];
-        sha256(mem, entry(i).size, d);
-        hex32(d, hex);
-        free(mem);
-        return;
-    }
-    sha_range(f, base, entry(i).size, hex, 0);
-    if (!package) plat_file_close(f);
-}
-
-// ---- index lookup
-static uint64_t lower(const char *name) {
-    uint64_t lo = 0, hi = file_count;
-    while (lo < hi) {
-        uint64_t m = lo + (hi - lo) / 2;
-        if (strcmp(entry_name(entry(m)), name) < 0) lo = m + 1;
-        else hi = m;
-    }
-    return lo;
-}
-
-static size_t added_lower(const char *p) {
-    size_t lo = 0, hi = nadded;
-    while (lo < hi) {
-        size_t m = lo + (hi - lo) / 2;
-        if (strcmp(added[m], p) < 0) lo = m + 1;
-        else hi = m;
-    }
-    return lo;
-}
-
-// The index of RomFS path p (an added file: file_count + k), or UINT64_MAX.
-static uint64_t file_index(const char *p) {
-    uint64_t i = lower(p);
-    if (i < file_count && !strcmp(p, entry_name(entry(i)))) return i;
-    size_t k = added_lower(p);
-    return k < nadded && !strcmp(added[k], p) ? file_count + k : UINT64_MAX;
-}
-
-// 1 when a RomFS file or an added one lies under folder (a path ending in '/').
-static int folder_exists(const char *folder) {
-    size_t n = strlen(folder);
-    uint64_t i = lower(folder);
-    if (i < file_count && !strncmp(entry_name(entry(i)), folder, n)) return 1;
-    size_t k = added_lower(folder);
-    return k < nadded && !strncmp(added[k], folder, n);
-}
-
-// The overlay slot + 1 that replaces RomFS file i, or 0.
-static uint32_t overlay_slot(uint64_t i) {
-    size_t lo = 0, hi = noverlay;
-    while (lo < hi) {
-        size_t m = lo + (hi - lo) / 2;
-        if (overlays[m].index < i) lo = m + 1;
-        else hi = m;
-    }
-    return lo < noverlay && overlays[lo].index == i ? (uint32_t)(lo + 1) : 0;
-}
-
-// ---- overlays
-static void overlay_load(const char *dir) {
-    char path[2100];
-    need(snprintf(path, sizeof path, "%s/manifest.tsv", dir) < (int)sizeof path, "overlay path");
-    FILE *m = fopen(path, "rb");
-    if (!m) {
-        rt_log("RomFS overlay: none (%s)", path);
-        return;
-    }
-    char line[8192];
-    size_t first = noverlay;
-    uint64_t hashed = 0;
-    double t0 = now_s();
-    while (fgets(line, sizeof line, m)) {
-        if (line[0] == '#' || line[0] == '\n' || line[0] == '\r') continue;
-        char name[4096], sha[65], orig[65], hex[65];
-        unsigned long long size = 0;
-        need(sscanf(line, "%4095[^\t]\t%llu\t%64[0-9a-f]\t%64[0-9a-f-]", name, &size, sha, orig) == 4 &&
-             strlen(sha) == 64 && (strlen(orig) == 64 || !strcmp(orig, "-")), "overlay manifest line");
-        need(romfs_path_valid_relative(name), "overlay path");
-        uint64_t i = lower(name);
-        int known = i < file_count && !strcmp(entry_name(entry(i)), name), add = !strcmp(orig, "-");
-        if (!known && !add)
-            rt_fatal("RomFS overlay: %s/manifest.tsv names %s, which the RomFS lacks; a new file has \"-\" as its "
-                     "original's SHA-256", dir, name);
-        if (known && add)
-            rt_fatal("RomFS overlay: %s/manifest.tsv adds %s, which the RomFS already has; give its original's SHA-256",
-                     dir, name);
-        Entry e = {0};
-        if (known) {
-            e = entry(i);
-            sha_row(i, hex);
-            if (strcmp(hex, orig)) rt_fatal("RomFS overlay: the original of %s has SHA-256 %s, %s/manifest.tsv says %s",
-                                            name, hex, dir, orig);
-        } else {
-            i = ADDED;
-        }
-        char file[8200];
-        need(snprintf(file, sizeof file, "%s/%s", dir, name) < (int)sizeof file, "overlay file path");
-        PlatFile *f = open_read(file);
-        if (!f) rt_fatal("RomFS overlay: %s missing", file);
-        Identity id = identity_of(f);
-        if (id.size != size) rt_fatal("RomFS overlay: %s has %llu bytes, its manifest says %llu", file,
-                                      (unsigned long long)id.size, size);
-        sha_range(f, 0, size, hex, 0);
-        plat_file_close(f);
-        if (strcmp(hex, sha)) rt_fatal("RomFS overlay: %s has SHA-256 %s, its manifest says %s", file, hex, sha);
-        hashed += e.size + size;
-        if (noverlay == overlay_cap) {
-            overlay_cap = overlay_cap ? overlay_cap * 2 : 16;
-            overlays = realloc(overlays, overlay_cap * sizeof *overlays);
-            need(overlays != NULL, "overlay table");
-        }
-        char *copy = strdup(file), *rel = strdup(name);
-        need(copy && rel, "overlay path copy");
-        overlays[noverlay++] = (Overlay){i, size, copy, rel, id, load_seq};
-        if (noverlay - first <= 16)
-            rt_log("RomFS overlay: %s (%llu bytes) %s", name, size, add ? "is added" : "replaces the original");
-    }
-    fclose(m);
-    if (noverlay - first > 16) rt_log("RomFS overlay: %zu files from %s (%zu not listed)", noverlay - first, dir,
-                                      noverlay - first - 16);
-    if (noverlay > first) rt_log("RomFS overlay: %s checked, %zu files, %.1f MiB hashed in %.2f s", dir,
-                                 noverlay - first, hashed / 1048576.0, now_s() - t0);
-}
-
-static int overlay_order(const void *a, const void *b) {
-    uint64_t x = ((const Overlay *)a)->index, y = ((const Overlay *)b)->index;
-    // added files all share ADDED until added_init numbers them: never equal, keep load order among them
-    if (x == ADDED || y == ADDED) return (x > y) - (x < y);
-    if (x != y) return (x > y) - (x < y);
-    unsigned ox = ((const Overlay *)a)->ord, oy = ((const Overlay *)b)->ord;
-    return (ox > oy) - (ox < oy);
-}
-
-static int added_order(const void *a, const void *b) {
-    int c = strcmp((*(Overlay *const *)a)->name, (*(Overlay *const *)b)->name);
-    if (c) return c;
-    unsigned x = (*(Overlay *const *)a)->ord, y = (*(Overlay *const *)b)->ord;
-    return (x > y) - (x < y);
-}
-
-// Number the added files in path order after the RomFS's own (file_count + k); two overlays adding one path stop.
-static void added_init(void) {
-    Overlay **list = NULL;
-    for (size_t k = 0; k < noverlay; k++)
-        if (overlays[k].index == ADDED) {
-            list = realloc(list, (nadded + 1) * sizeof *list);
-            need(list != NULL, "added files");
-            list[nadded++] = &overlays[k];
-        }
-    if (!nadded) return;
-    qsort(list, nadded, sizeof *list, added_order);
-    // two mods adding one path: the later mod wins, like replacements (the MODS order is the precedence)
-    size_t kept = 0;
-    for (size_t k = 0; k < nadded; k++) {
-        if (kept && !strcmp(list[k]->name, list[kept - 1]->name)) {
-            rt_log("RomFS overlay: %s loses added %s to %s", list[kept - 1]->path, list[k]->name, list[k]->path);
-            free(list[kept - 1]->path);
-            free(list[kept - 1]->name);
-            list[kept - 1] = list[k];
-        } else {
-            list[kept++] = list[k];
-        }
-    }
-    nadded = kept;
-    added = malloc(nadded * sizeof *added);
-    need(added != NULL, "added files");
-    for (size_t k = 0; k < nadded; k++) {
-        list[k]->index = file_count + k;
-        added[k] = list[k]->name;
-    }
-    free(list);
-    rt_log("RomFS overlay: %zu files added to the RomFS", nadded);
-}
-
-// <game dir>/lang/<code> for a rebuilt game language, NULL for one the game ships.
-static const char *lang_overlay(void) {
-    static char dir[PLAT_PATH_MAX * 2];
-    const char *code = ov_text_language();
-    if (!code) return NULL;
-    snprintf(dir, sizeof dir, "%s/lang/%s", cfg_game_dir(), code);
-    return dir;
-}
-
-// The bytes a read of rel gets from the overlays loaded so far (the last one that replaces it), else the RomFS's own.
-uint8_t *romfs_read_top(const char *rel, uint64_t *size) {
-    const Overlay *top = NULL;
-    for (size_t k = 0; k < noverlay; k++)
-        if (overlays[k].index != ADDED && !strcmp(overlays[k].name, rel) && (!top || overlays[k].ord >= top->ord))
-            top = &overlays[k];
-    if (!top) return romfs_read_whole(rel, size);
-    return (uint8_t *)plat_file_read(top->path, size);
-}
-
-int romfs_original_sha(const char *rel, char hex[65]) {
-    uint64_t i = lower(rel);
-    if (i >= file_count || strcmp(entry_name(entry(i)), rel)) return 0;
-    sha_row(i, hex);
-    return 1;
-}
-
-static void overlay_init(void) {
-    // MKW_ROMFS_PATCHES (the scripts' build/romfs-res) goes first, as before the mods; else the resolution setting
-    // writes its own last, over whatever the mods left of its archive (a mod that ships general_format, as Classic
-    // GP does, replaced the resolution's copy and the setting did nothing)
-    const char *patches = cfg_get("MKW_ROMFS_PATCHES");
-    if (patches && *patches && strcmp(patches, "0")) {
-        romfs_resolution_external();
-        load_seq++;
-        overlay_load(patches);
-    }
-    const char *legacy = cfg_get("MKW_ROMFS_MODS");
-    if (legacy && *legacy && strcmp(legacy, "0")) {
-        load_seq++;
-        overlay_load(legacy);
-    }
-    // the Mods page's enabled mods, in MODS order: later mods win shared files
-    const char *game = cfg_game_dir();
-    char mods[4096], seen[64][64];
-    size_t nseen = 0;
-    const char *list = cfg_get("MKW_MODS");
-    // a bug report's log says which mods were on (tools/github/classify.py mods_enabled asks for a run without them)
-    if (list && *list) rt_log("mods: enabled %s", list);
-    if (list && *list) {
-        snprintf(mods, sizeof mods, "%s", list);
-        for (char *t = strtok(mods, ","); t; t = strtok(NULL, ",")) {
-            while (*t == ' ') t++;
-            char *e = t + strlen(t);
-            while (e > t && (e[-1] == ' ' || e[-1] == '\t')) *--e = 0;
-            if (!*t || strlen(t) >= sizeof seen[0] || nseen >= 64) continue;
-            size_t k = 0;
-            while (k < nseen && strcmp(seen[k], t)) k++;
-            if (k < nseen) continue;
-            snprintf(seen[nseen++], sizeof seen[0], "%s", t);
-            char dir[PLAT_PATH_MAX * 2 + 16];
-            snprintf(dir, sizeof dir, "%s/mods/%s/romfs", game, t);
-            load_seq++;
-            overlay_load(dir);
-        }
-    }
-    // the Mods page's merge of the enabled mods' shared archives (tools/mod/merge.py); missing when
-    // nothing is shared, and then this is a no-op log line like a missing legacy dir. Gated on MODS so a
-    // stale .merged from an earlier enablement never applies after the last mod is toggled off.
-    const char *mods_on = cfg_get("MKW_MODS");
-    if (mods_on && *mods_on) {
-        char merged[PLAT_PATH_MAX * 2 + 16];
-        snprintf(merged, sizeof merged, "%s/mods/.merged/romfs", game);
-        load_seq++;
-        overlay_load(merged);
-    }
-    // the language after the mods: a mod's copy of a text archive would leave a translated menu half in Spanish
-    const char *lang = lang_overlay();
-    if (lang && *lang) {
-        load_seq++;
-        overlay_load(lang);
-    }
-    const char *res = patches && *patches ? NULL : romfs_resolution_overlay();
-    if (res) {
-        load_seq++;
-        overlay_load(res);
-    }
-    added_init();
-    if (noverlay) qsort(overlays, noverlay, sizeof *overlays, overlay_order);
-    // two dirs replacing one file: the later dir wins (MODS order); the loser's strings are freed
-    size_t kept = 0;
-    for (size_t k = 0; k < noverlay; k++) {
-        if (kept && overlays[k].index != ADDED && overlays[k].index == overlays[kept - 1].index) {
-            rt_log("RomFS overlay: %s loses %s to %s", overlays[kept - 1].path, overlays[k].name, overlays[k].path);
-            free(overlays[kept - 1].path);
-            free(overlays[kept - 1].name);
-            overlays[kept - 1] = overlays[k];
-        } else {
-            overlays[kept++] = overlays[k];
-        }
-    }
-    noverlay = kept;
-}
