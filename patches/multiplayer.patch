+        opt_choice_list("MKW_HUD_POSITION", UI_MENU_HUD_POSITION, vals, names, 2, UI_MENU_HUD_POSITION_DESC);
+    }
+    {   // the game's own HDR picture on an HDR display (gfx/nvn/host/gfx_hdr.c), live
