+// regardless of ini, environment overrides or an already-open menu.
+static int mkwom_hack_setting(const char *name) {
+    if (strncmp(name, "MKW_", 4)) return 0;
+    const char *key = name + 4;
+    static const char *keys[] = {"TURBO", "TURBO_SPEED", "SKIP_MOVIES", "SEED",
+        "UNLOCK_ALL", "QUICK_RACE", "FREEZE_KEYS", "CLASSIC_GP", "CLASSIC_VS", "MODS"};
+    for (size_t i = 0; i < sizeof keys / sizeof *keys; i++)
+        if (!strcmp(key, keys[i])) return 1;
+    return 0;
+}
+
+static int mkwom_online_hacks_blocked(void) {
+    const char *online = raw_get("MKW_ONLINE");
+    return online && *online && strcmp(online, "0");
+}
+
+static const char *mkwom_hack_disabled_value(const char *name) {
+    if (!strcmp(name, "MKW_TURBO") || !strcmp(name, "MKW_QUICK_RACE")) return "off";
+    if (!strcmp(name, "MKW_TURBO_SPEED")) return "4";
+    if (!strcmp(name, "MKW_SEED") || !strcmp(name, "MKW_MODS")) return "";
+    return "0";
+}
+
